---
/**
 * AskTheData — the "Ask the databases" chat box (Supply + Rent tabs).
 * Same shape as the countypermit public demo's Ask-the-pipeline page: an intro bubble,
 * a numbered guided tour (click to ask, one at a time), the conversation, the input,
 * and under every answer an evidence strip built from the tool loop's recorded records
 * — never from the model. Styled in this site's tokens, no framework.
 */
import { CHAT_API_PRODUCTION, CHAT_API_LOCAL, DAILY_LIMIT, TOUR } from "../../data/chat/config.ts";

interface Props { page: "supply" | "rents"; }
const { page } = Astro.props;

const intro = page === "supply"
  ? "Ask the supply database — and the rent and demand databases it shares a server with."
  : "Ask the rent database — and the supply and demand databases it shares a server with.";
const lead = page === "supply"
  ? "This box runs the same Model Context Protocol server I query from claude.ai: nine metros of supply, the weekly rent scrape, and Census demand rings. Five single-database questions, then three that cross them."
  : "This box runs the same Model Context Protocol server I query from claude.ai: the weekly rent scrape, nine metros of supply, and Census demand rings. Five single-database questions, then three that cross them.";
const placeholder = page === "supply"
  ? "Ask about supply, rents or demand…"
  : "Ask about rents, supply or demand…";
---

<div class="ask" data-ask data-page={page}>
  <div class="ask__intro">
    <div class="ask__avatar" aria-hidden="true">✦</div>
    <div class="ask__bot">
      <p class="ask__intro-h">{intro}</p>
      <p class="ask__intro-p">{lead} <strong>Click a question to ask it.</strong></p>
    </div>
  </div>

  <div class="ask__tour">
    <p class="ask__tour-label">Guided tour · one MCP method per question</p>
    <div class="ask__grid" data-tour>
      {TOUR.map((t, i) => (
        <button type="button" class="ask__q" data-idx={i} data-q={t.q}>
          <span class="ask__num">{i + 1}</span>
          <span class="ask__q-body">
            <span class="ask__q-text">{t.q}</span>
            <span class={`ask__method ask__method--${t.kind}`}>{t.kind === "cross" ? "cross" : t.kind} · {t.method}</span>
          </span>
        </button>
      ))}
    </div>
  </div>

  <div class="ask__log" data-log></div>

  <div class="ask__limit" data-limit hidden>
    <p>You've used {DAILY_LIMIT} questions today from this browser. The server has its own caps too; come back tomorrow, or connect the MCP server to your own Claude.</p>
  </div>

  <form class="ask__form" data-form>
    <input class="ask__input" data-input type="text" autocomplete="off" placeholder={placeholder} />
    <button class="ask__send" data-send type="submit">Send</button>
  </form>
  <p class="ask__foot">
    <span data-quota>{DAILY_LIMIT} questions left today</span> · the server also limits questions per hour · answers are grounded in live data from the three databases; verify before acting.
  </p>
</div>

<script define:vars={{ CHAT_API_PRODUCTION, CHAT_API_LOCAL, DAILY_LIMIT }}>
  window.__ASK_CFG = { CHAT_API_PRODUCTION, CHAT_API_LOCAL, DAILY_LIMIT };
</script>
<script>
  import { renderReply } from "./render-reply";
  import { readChatStream, createDraft, createFacts, stageLabel, streamUrl, type ChatEvent } from "./chat-stream";

  const cfg = (window as any).__ASK_CFG as { CHAT_API_PRODUCTION: string; CHAT_API_LOCAL: string; DAILY_LIMIT: number };
  const API = ["localhost", "127.0.0.1"].includes(location.hostname) ? cfg.CHAT_API_LOCAL : cfg.CHAT_API_PRODUCTION;
  const STREAM_API = streamUrl(API);
  const LS_KEY = "ask_the_data_usage_v1";
  const CONF_TITLES: Record<string, string> = {
    high: "A confirmed permit record, a scraped rent listing, or a Census ring backs this.",
    medium: "Backed by an early-radar filing — unit counts are acreage estimates.",
    low: "No database record cited — answered from methodology, or out of scope.",
  };

  type Usage = { date: string; count: number; asked: number[] };
  const today = () => new Date().toISOString().slice(0, 10);
  function loadUsage(): Usage {
    try {
      const u = JSON.parse(localStorage.getItem(LS_KEY) || "{}");
      if (u.date === today()) return { date: u.date, count: u.count || 0, asked: u.asked || [] };
    } catch {}
    return { date: today(), count: 0, asked: [] };
  }
  function saveUsage(u: Usage) { try { localStorage.setItem(LS_KEY, JSON.stringify(u)); } catch {} }
  const esc = (s: unknown) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));

  document.querySelectorAll<HTMLElement>("[data-ask]").forEach((root) => {
    const log = root.querySelector<HTMLElement>("[data-log]")!;
    const form = root.querySelector<HTMLFormElement>("[data-form]")!;
    const input = root.querySelector<HTMLInputElement>("[data-input]")!;
    const sendBtn = root.querySelector<HTMLButtonElement>("[data-send]")!;
    const quota = root.querySelector<HTMLElement>("[data-quota]")!;
    const limit = root.querySelector<HTMLElement>("[data-limit]")!;
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>(".ask__q"));
    const history: { role: string; content: string }[] = [];
    let usage = loadUsage();
    let busy = false;

    const remaining = () => Math.max(0, cfg.DAILY_LIMIT - usage.count);
    const atLimit = () => usage.count >= cfg.DAILY_LIMIT;
    function renderQuota() {
      const r = remaining();
      quota.textContent = r > 0 ? `${r} question${r === 1 ? "" : "s"} left today` : "Daily limit reached";
    }
    function lockUI() {
      input.disabled = true; sendBtn.disabled = true;
      input.placeholder = "Daily limit reached";
      chips.forEach((b) => b.classList.add("is-locked"));
      limit.hidden = false;
    }
    function markAsked() { chips.forEach((b) => { if (usage.asked.includes(Number(b.dataset.idx))) b.classList.add("is-asked"); }); }

    function addUser(text: string) {
      const row = document.createElement("div"); row.className = "ask__row ask__row--user";
      const b = document.createElement("div"); b.className = "ask__user"; b.textContent = text;
      row.appendChild(b); log.appendChild(row);
    }
    function botRow() {
      const row = document.createElement("div"); row.className = "ask__row";
      row.innerHTML = '<div class="ask__avatar" aria-hidden="true">✦</div>';
      const b = document.createElement("div"); b.className = "ask__bot";
      b.innerHTML =
        '<div class="ask__pending" role="status" aria-live="polite">' +
          '<span class="ask__typing" aria-hidden="true"><i></i><i></i><i></i></span>' +
          '<span class="ask__stage" data-stage>Sending the question to the model…</span>' +
          '<span class="ask__elapsed" data-elapsed>0s</span>' +
        '</div>' +
        '<ul class="ask__facts" data-facts aria-live="polite" hidden></ul>' +
        '<div class="ask__notes" data-notes hidden></div>' +
        '<div class="ask__draft" data-draft hidden></div>';
      row.appendChild(b); log.appendChild(row);
      return { row, bubble: b };
    }

    /**
     * Timer-driven stages, used only until the stream's first progress event arrives (and
     * on the /chat fallback, which has no events). Once /chat/stream reports a stage, the
     * label follows the real events; the elapsed counter is always measured.
     */
    const STAGES: [number, string][] = [
      [0, "Sending the question to the model…"],
      [3, "Choosing which MCP methods to call…"],
      [8, "Querying the databases over MCP…"],
      [18, "Reading the records back and composing the answer…"],
      [32, "Still working — a cross-database question can take a minute."],
    ];
    function startPending(bubble: HTMLElement) {
      const stageEl = bubble.querySelector<HTMLElement>("[data-stage]");
      const elapsedEl = bubble.querySelector<HTMLElement>("[data-elapsed]");
      const t0 = Date.now();
      let live: string | null = null;   // set by stream events; overrides the timer
      const tick = () => {
        const secs = Math.floor((Date.now() - t0) / 1000);
        if (elapsedEl) elapsedEl.textContent = secs + "s";
        let label = STAGES[0][1];
        for (const [at, text] of STAGES) if (secs >= at) label = text;
        if (live) label = live;
        if (stageEl && stageEl.textContent !== label) stageEl.textContent = label;
      };
      tick();
      const id = window.setInterval(tick, 1000);
      return {
        stop: () => window.clearInterval(id),
        set: (label: string) => { live = label; tick(); },
      };
    }
    function groundingEl(data: any): HTMLElement | null {
      const ev = data.evidence || [], tu = data.tools_used || [];
      if (!data.confidence && !ev.length && !tu.length && !data.truncated) return null;
      const wrap = document.createElement("div"); wrap.className = "ask__ground";
      // truncated = the model stopped on max_tokens (backend contract). Style on the
      // field, never on status: status stays "ok" so history and quota still count it.
      if (data.truncated) {
        const cut = document.createElement("span"); cut.className = "ask__trunc";
        cut.textContent = "✂ answer cut short — ask a narrower question";
        wrap.appendChild(cut);
      }
      if (data.confidence) {
        const pill = document.createElement("span");
        pill.className = "ask__conf ask__conf--" + data.confidence;
        pill.textContent = data.confidence + " confidence";
        pill.title = CONF_TITLES[data.confidence] || "";
        wrap.appendChild(pill);
      }
      if (ev.length || tu.length) {
        const det = document.createElement("details"); det.className = "ask__ev";
        const sum = document.createElement("summary");
        const parts: string[] = [];
        if (tu.length) parts.push(tu.length + " tool call" + (tu.length > 1 ? "s" : ""));
        // evidence caps at 15; evidence_total is the distinct count before the cap
        const total = Math.max(ev.length, Number(data.evidence_total) || 0);
        if (ev.length) parts.push((total > ev.length ? ev.length + " of " + total : ev.length) + " record" + (total > 1 ? "s" : ""));
        sum.textContent = "what it looked up · " + parts.join(" · ");
        det.appendChild(sum);
        const body = document.createElement("div"); body.className = "ask__ev-body";
        if (tu.length) {
          body.insertAdjacentHTML("beforeend", '<div class="ask__ev-label">MCP methods called, in order</div>');
          tu.forEach((t: any) => {
            const args = t.args && Object.keys(t.args).length ? " " + esc(JSON.stringify(t.args)) : "";
            body.insertAdjacentHTML("beforeend", `<div class="ask__ev-tool">${esc(t.tool)}${args}</div>`);
          });
        }
        if (ev.length) {
          body.insertAdjacentHTML("beforeend", '<div class="ask__ev-label">Records cited</div><ul class="ask__ev-list"></ul>');
          const ul = body.querySelector("ul")!;
          ev.forEach((e: any) => {
            ul.insertAdjacentHTML("beforeend",
              `<li><span class="ask__ev-src">${esc(e.source)}</span>${e.name ? " — " + esc(e.name) : ""}${e.id ? ` <span class="ask__ev-id">#${esc(e.id)}</span>` : ""}</li>`);
          });
        }
        det.appendChild(body); wrap.appendChild(det);
      }
      return wrap;
    }

    /**
     * Live progress + the answer as it is written. Draft and notes are re-rendered
     * through renderReply (at most every 60 ms — a timer, because requestAnimationFrame
     * pauses in a background tab), so partial text obeys the same no-live-markup rule as
     * the final answer; `done` then replaces the bubble with the authoritative reply
     * (which carries the truncation marker when there is one).
     */
    function streamHandler(bubble: HTMLElement, setStage: (label: string) => void) {
      const draft = createDraft();
      const facts = createFacts();
      const factsEl = bubble.querySelector<HTMLElement>("[data-facts]")!;
      const draftEl = bubble.querySelector<HTMLElement>("[data-draft]")!;
      const notesEl = bubble.querySelector<HTMLElement>("[data-notes]")!;
      const waiting: string[] = [];
      let frame = 0;
      const paint = () => {
        frame = 0;
        notesEl.hidden = !draft.notes.length;
        notesEl.innerHTML = draft.notes.map((n) => renderReply(n)).join("");
        draftEl.hidden = !draft.text;
        draftEl.innerHTML = draft.text ? renderReply(draft.text) : "";
      };
      return (ev: ChatEvent) => {
        if (ev.type === "stage" && ev.stage === "tools") waiting.splice(0, waiting.length, ...(ev.tools || []));
        if (ev.type === "tool_done") { const i = waiting.indexOf(ev.tool); if (i >= 0) waiting.splice(i, 1); }
        // Facts as they land: one real number per finished tool, seconds after it lands,
        // while the model is still composing. textContent only — a fact is never markup.
        if (facts.apply(ev)) {
          const it = facts.items[facts.items.length - 1];
          const li = document.createElement("li");
          const k = document.createElement("span"); k.className = "ask__fact-k"; k.textContent = it.label;
          const v = document.createElement("span"); v.textContent = it.text;
          li.append(k, v); factsEl.appendChild(li); factsEl.hidden = false;
        }
        const label = stageLabel(ev, waiting);
        if (label) setStage(label);
        if (ev.type === "delta" || ev.type === "reset") {
          const before = draft.text;
          draft.apply(ev);
          if (ev.type === "delta" && !before) setStage("The model is writing…");
          if (!frame) frame = window.setTimeout(paint, 60);
        }
      };
    }

    async function send(text: string, idx: number | null, chip: HTMLButtonElement | null = null) {
      if (busy || atLimit()) return;
      busy = true; sendBtn.disabled = true; input.value = "";
      if (chip) { chip.classList.add("is-running"); chip.setAttribute("aria-busy", "true"); }
      addUser(text);
      const { row, bubble } = botRow();
      const pending = startPending(bubble);
      const stopPending = pending.stop;
      // behavior:"smooth" silently no-ops where reduced motion is on, which left the
      // pending bubble ~2,000px below the chip the visitor just clicked — the whole
      // "nothing happened" report. Fall back to an instant jump in that case.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      row.scrollIntoView({ block: "center", behavior: reduced ? "auto" : "smooth" });
      const ctl = new AbortController();
      const killer = window.setTimeout(() => ctl.abort(), 180000);
      try {
        const post = (url: string) => fetch(url, {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message: text, history: history.slice(-6) }),
          signal: ctl.signal,
        });
        let data: any;
        let res = await post(STREAM_API);
        if (res.status === 404 || res.status === 405) {
          // Backend without /chat/stream yet: the one-shot endpoint. A 404 never reached
          // the rate limiter, so this is not a second charge against the visitor.
          res = await post(API);
          if (!res.ok) throw new Error("HTTP " + res.status);
          data = await res.json();
        } else {
          if (!res.ok) throw new Error("HTTP " + res.status);
          data = await readChatStream(res, streamHandler(bubble, pending.set));
        }
        stopPending();
        bubble.innerHTML = renderReply(data.reply);
        bubble.querySelectorAll("table").forEach((t) => { const w = document.createElement("div"); w.className = "ask__tbl"; t.replaceWith(w); w.appendChild(t); });
        const g = groundingEl(data); if (g) bubble.appendChild(g);
        if (data.status === "ok") {
          history.push({ role: "user", content: text }, { role: "assistant", content: data.reply });
          usage.count += 1; if (idx !== null) usage.asked.push(idx); saveUsage(usage);
          renderQuota(); markAsked();
          if (atLimit()) lockUI();
        }
      } catch (e) {
        stopPending();
        bubble.textContent = (e as Error)?.name === "AbortError"
          ? "That one timed out after three minutes — try it again, or ask a narrower question."
          : "Couldn't reach the assistant — try again in a moment.";
      } finally {
        window.clearTimeout(killer);
        stopPending();
        if (chip) { chip.classList.remove("is-running"); chip.removeAttribute("aria-busy"); }
        busy = false; if (!atLimit()) sendBtn.disabled = false;
      }
    }

    chips.forEach((b) => b.addEventListener("click", () => {
      if (b.classList.contains("is-asked") || b.classList.contains("is-locked")) return;
      send(b.dataset.q || "", Number(b.dataset.idx), b);
    }));
    form.addEventListener("submit", (ev) => { ev.preventDefault(); const t = input.value.trim(); if (t) send(t, null); });

    renderQuota(); markAsked(); if (atLimit()) lockUI();
  });
</script>

<style>
  /*
   * Scoping note: every node inside .ask__log is created in JS, so it never gets Astro's
   * data-astro-cid attribute and scoped selectors do not reach it. Those rules are written
   * as `.ask :global(...)` — scoped by the server-rendered .ask ancestor, global on the
   * dynamic descendant. Without this the whole conversation (user bubble, bot bubble,
   * typing dots, evidence strip) rendered as unstyled text.
   */
  .ask { max-width: var(--measure, 72ch); font-family: var(--sans); color: var(--fg); }
  .ask__intro { display: flex; gap: 12px; align-items: flex-start; margin: 0 0 18px; }
  .ask :global(.ask__row) { display: flex; gap: 12px; align-items: flex-start; margin: 0 0 18px; }
  .ask :global(.ask__row--user) { justify-content: flex-end; }
  .ask__avatar,
  .ask :global(.ask__avatar) { flex: 0 0 30px; width: 30px; height: 30px; border-radius: 50%; background: var(--code-bg); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 14px; }
  .ask__bot,
  .ask :global(.ask__bot) { background: var(--bg); border: 1px solid var(--rule); border-radius: 12px 12px 12px 4px; padding: 12px 16px; font-size: 0.92rem; line-height: 1.55; max-width: 90%; }
  .ask :global(.ask__bot p) { margin: 0 0 8px; } .ask :global(.ask__bot p:last-child) { margin-bottom: 0; }
  .ask :global(.ask__bot ul), .ask :global(.ask__bot ol) { margin: 4px 0 8px; padding-left: 20px; }
  .ask :global(.ask__bot code) { font-family: var(--mono); font-size: 0.85em; background: var(--code-bg); padding: 1px 4px; border-radius: 3px; }
  .ask :global(.ask__bot table) { border-collapse: collapse; font-size: 0.85rem; width: 100%; }
  .ask :global(.ask__bot th), .ask :global(.ask__bot td) { border: 1px solid var(--rule); padding: 4px 8px; text-align: left; white-space: nowrap; }
  .ask :global(.ask__tbl) { overflow-x: auto; margin: 6px 0; }
  .ask__intro-h { font-weight: 600; margin: 0 0 4px; }
  .ask__intro-p { margin: 0; color: var(--fg-soft); }
  .ask :global(.ask__user) { background: var(--accent); color: var(--bg); border-radius: 12px 12px 4px 12px; padding: 10px 14px; font-size: 0.92rem; max-width: 80%; white-space: pre-wrap; }
  .ask__tour { margin: 0 0 18px 42px; }
  .ask__tour-label { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .ask__grid { display: grid; grid-template-columns: 1fr; gap: 8px; }
  @media (min-width: 640px) { .ask__grid { grid-template-columns: 1fr 1fr; } }
  .ask__q { display: flex; gap: 9px; align-items: flex-start; border: 1px solid var(--rule); border-radius: 10px; padding: 10px 12px; background: var(--bg); color: var(--fg); cursor: pointer; text-align: left; font: inherit; font-size: 0.86rem; line-height: 1.35; transition: border-color .15s, background .15s; }
  .ask__q:hover { border-color: var(--accent); background: var(--code-bg); }
  .ask__q.is-asked { color: var(--muted); cursor: default; border-color: var(--rule-soft); }
  .ask__q.is-asked .ask__num { background: var(--accent); color: var(--bg); }
  .ask__q.is-locked { opacity: .5; cursor: not-allowed; }
  .ask__q.is-running { border-color: var(--accent); background: var(--code-bg); cursor: progress; }
  .ask__q.is-running .ask__num { background: transparent; color: transparent; border: 2px solid var(--rule); border-top-color: var(--accent); animation: askspin .7s linear infinite; }
  .ask__num { flex: 0 0 18px; width: 18px; height: 18px; border-radius: 50%; background: var(--code-bg); color: var(--accent); font-family: var(--mono); font-size: 0.7rem; font-weight: 600; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
  .ask__q-body { display: flex; flex-direction: column; gap: 4px; }
  .ask__method { font-family: var(--mono); font-size: 0.68rem; color: var(--muted); }
  .ask__method--cross { color: var(--accent); }
  .ask__log > :global(.ask__row + .ask__row) { margin-top: 18px; }
  .ask__limit { margin: 0 0 14px 42px; border: 1px solid var(--rule); background: var(--code-bg); border-radius: 10px; padding: 12px 16px; font-size: 0.88rem; }
  .ask__limit p { margin: 0; }
  .ask__form { display: flex; gap: 8px; align-items: center; margin-top: 8px; }
  .ask__input { flex: 1; padding: 10px 12px; border: 1px solid var(--rule); border-radius: 10px; background: var(--bg); color: var(--fg); font: inherit; font-size: 0.92rem; }
  .ask__input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .ask__send { padding: 10px 16px; border: 0; border-radius: 10px; background: var(--accent); color: var(--bg); font: inherit; font-size: 0.9rem; font-weight: 600; cursor: pointer; }
  .ask__send:disabled { opacity: .45; cursor: not-allowed; }
  .ask__foot { margin: 8px 0 0; font-size: 0.74rem; color: var(--muted); text-align: center; }
  .ask :global(.ask__ground) { margin-top: 9px; padding-top: 7px; border-top: 1px dashed var(--rule); display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .ask :global(.ask__conf) { font-family: var(--mono); font-size: 0.66rem; font-weight: 600; padding: 2px 9px; border-radius: 999px; cursor: help; border: 1px solid var(--rule); }
  .ask :global(.ask__conf--high) { color: var(--accent); }
  .ask :global(.ask__conf--medium) { color: var(--fg-soft); }
  .ask :global(.ask__conf--low) { color: var(--muted); }
  .ask :global(.ask__trunc) { font-family: var(--mono); font-size: 0.66rem; padding: 2px 9px; border-radius: 999px; border: 1px dashed var(--rule); color: var(--fg-soft); }
  .ask :global(.ask__ev summary) { cursor: pointer; color: var(--muted); font-family: var(--mono); font-size: 0.7rem; list-style: none; user-select: none; }
  .ask :global(.ask__ev summary::-webkit-details-marker) { display: none; }
  .ask :global(.ask__ev summary::before) { content: "▸ "; } .ask :global(.ask__ev[open] summary::before) { content: "▾ "; }
  .ask :global(.ask__ev-body) { margin-top: 6px; padding: 8px 11px; background: var(--code-bg); border: 1px solid var(--rule); border-radius: 8px; max-width: 560px; }
  .ask :global(.ask__ev-label) { font-family: var(--mono); font-size: 0.62rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 600; margin: 6px 0 2px; }
  .ask :global(.ask__ev-label:first-child) { margin-top: 0; }
  .ask :global(.ask__ev-tool) { font-family: var(--mono); font-size: 0.72rem; color: var(--fg-soft); word-break: break-word; }
  .ask :global(.ask__ev-list) { margin: 2px 0 0; padding-left: 15px; } .ask :global(.ask__ev-list li) { font-size: 0.78rem; margin: 2.5px 0; }
  .ask :global(.ask__ev-src) { color: var(--accent); font-weight: 500; } .ask :global(.ask__ev-id) { color: var(--muted); }
  .ask :global(.ask__pending) { display: flex; align-items: center; gap: 9px; }
  .ask :global(.ask__draft) { margin-top: 10px; }
  .ask :global(.ask__notes) { margin-top: 8px; font-size: 0.82rem; color: var(--muted); font-style: italic; }
  .ask :global(.ask__notes p) { margin: 0 0 4px; }
  .ask :global(.ask__stage) { font-size: 0.86rem; color: var(--fg-soft); }
