---
const path = Astro.url.pathname;
const current = (href: string) => {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href);
};
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand" aria-label="Herman Chan, home">
      <span class="brand__mark">
        Herman&nbsp;Chan<span class="glyph">·</span>
      </span>
      <span class="brand__sub">Acquisitions &amp; AI tooling</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="/" aria-current={current("/") ? "page" : undefined}>Index</a>
      <a href="/projects/" aria-current={current("/projects/") ? "page" : undefined}>Projects</a>
      <a href="/posts/" aria-current={current("/posts/") ? "page" : undefined}>Writing</a>
      <a href="/rss.xml" title="RSS feed">RSS</a>
    </nav>
  </div>
</header>
