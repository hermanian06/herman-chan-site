---
/* Six-tab nav (redesign, 2026-09-13). The old Index / Projects / Writing entries are
   gone from the bar; /projects/ and /posts/ still build and are reachable by URL, and the
   old landing is kept at /legacy/ until the redesign is signed off. */
const path = Astro.url.pathname;
const current = (href: string) => {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href);
};
const tabs = [
  { href: "/", label: "Intro" },
  { href: "/underwriting-agent/", label: "Underwriting Agent" },
  { href: "/supply-database/", label: "Supply Database" },
  { href: "/rent-database/", label: "Rent Database" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "About" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand" aria-label="Herman Chan, home">
      <span class="brand__mark">
        Herman&nbsp;Chan<span class="glyph">·</span>
      </span>
      <span class="brand__sub">Acquisitions &amp; AI tooling</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {tabs.map((t) => (
        <a href={t.href} aria-current={current(t.href) ? "page" : undefined}>{t.label}</a>
      ))}
    </nav>
  </div>
</header>
