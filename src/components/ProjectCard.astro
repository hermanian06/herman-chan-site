---
interface Props {
  href: string;
  title: string;
  blurb: string;
}

const { href, title, blurb } = Astro.props;
---

<a href={href} class="group block py-6 border-b border-rule no-underline">
  <h3 class="text-base font-medium text-ink group-hover:underline decoration-1 underline-offset-2">
    {title}
  </h3>
  <p class="text-sm text-ink-muted mt-1.5 leading-relaxed">{blurb}</p>
</a>
