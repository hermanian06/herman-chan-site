---
/**
 * Page head for the six redesign tabs: kicker · title · lede, plus an optional
 * "draft copy" line while Herman is still rewriting the bullets tab by tab.
 */
interface Props {
  kicker: string;
  title: string;
  lede?: string;
  draft?: boolean;
}
const { kicker, title, lede, draft = false } = Astro.props;
---

<section class="tabhead">
  <div class="wrap">
    <header class="tabhead__inner">
      <span class="kicker">{kicker}</span>
      <h1 class="tabhead__title">{title}</h1>
      {lede && <p class="tabhead__lede">{lede}</p>}
      {draft && (
        <p class="tabhead__draft">
          Draft copy — bullet points to be rewritten in this tab's dedicated session.
        </p>
      )}
    </header>
  </div>
</section>

<style>
  .tabhead { padding: clamp(48px, 7vw, 80px) 0 0; }
  .tabhead__inner { max-width: 700px; margin: 0; }
  .tabhead__inner .kicker { display: block; margin-bottom: var(--s-3); }
  .tabhead__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(32px, 4.6vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 var(--s-4);
    color: var(--fg);
    text-wrap: balance;
  }
  .tabhead__lede {
    font-family: var(--serif);
    font-size: var(--t-19);
    line-height: 1.55;
    color: var(--fg-soft);
    margin: 0;
    max-width: 54ch;
  }
  .tabhead__draft {
    font-family: var(--mono);
    font-size: var(--t-12);
    letter-spacing: 0.04em;
    color: var(--muted-2);
    margin: var(--s-4) 0 0;
    padding: 6px 10px;
    border: 1px dashed var(--rule);
    display: inline-block;
  }
</style>
