---
import ProjectMetrics from './ProjectMetrics.astro';
import type { Project } from '../../data/project-metrics';
interface Props {
  kicker: string; title: string; lede?: string; draft?: boolean; project?: Project;
  links?: { href: string; label: string }[];
}
const { kicker, title, lede, draft = false, project, links = [] } = Astro.props;
const hasAside = Boolean(project) || Astro.slots.has('aside');
---
<section class:list={["tabhead", { 'tabhead--project': hasAside }]}>
  <div class="wrap">
    <div class="tabhead__grid">
      <header class="tabhead__inner">
        <span class="kicker">{kicker}</span>
        <h1 class="tabhead__title">{title}</h1>
        {lede && <p class="tabhead__lede">{lede}</p>}
        {draft && <p class="tabhead__draft">Draft copy — bullet points to be rewritten in this tab's dedicated session.</p>}
      </header>
      <slot name="aside" />
      {project && <aside class:list={["tabhead__aside", { "tabhead__aside--metrics-only": project !== "underwriting" }]} aria-label="Project at a glance">
        <ProjectMetrics project={project} />
        {project === 'underwriting' && <a class="sample-preview" href="#sample">
          <span class="sample-preview__top"><span>Sample output</span><span aria-hidden="true">↗</span></span>
          <span class="sample-preview__title">Deal summary</span>
          <span class="sample-preview__rows"><span>Demand</span><span>Rent comps</span><span>Property tax</span><span>Supply</span><span>T-12 analysis</span><span>Rent roll analysis</span></span>
          <span class="sample-preview__foot">View the sample pack <span aria-hidden="true">→</span></span>
          <small>Mesa, Arizona · Financial numbers are illustrative.</small>
        </a>}
      </aside>}
    </div>
    {links.length > 0 && <nav class="section-nav" aria-label="On this page">{links.map((link,index)=><a href={link.href}><span>{String(index+1).padStart(2,'0')}</span>{link.label}<i aria-hidden="true">↓</i></a>)}</nav>}
  </div>
</section>
<style>
.tabhead{padding:58px 0 0}.tabhead__grid{display:grid;grid-template-columns:minmax(0,1fr);gap:48px}.tabhead--project .tabhead__grid{grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);gap:clamp(35px,5vw,76px);align-items:start}
.tabhead__inner{max-width:960px}.tabhead__title{font:var(--font-page-title);letter-spacing:var(--track-page-title);margin:16px 0 25px;color:var(--accent-ink);text-wrap:balance}.tabhead__lede{font:var(--font-lead);max-width:65ch;margin:0;color:var(--fg-soft)}
.tabhead__aside{padding-top:7px}.section-nav{display:flex;flex-wrap:wrap;gap:0 34px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);margin-top:40px;padding:12px 0}.section-nav a{display:flex;align-items:center;gap:12px;min-height:44px;font:14px var(--sans);color:var(--accent-ink)}.section-nav a span{font:12px var(--mono);color:var(--muted)}.section-nav a i{font-style:normal;color:var(--accent)}
.sample-preview{display:block;margin-top:25px;padding:24px;background:var(--bg-alt);color:var(--accent-ink);border-top:2px solid var(--accent)}.sample-preview:hover{text-decoration:none;background:#e1eaf5}.sample-preview__top{display:flex;justify-content:space-between;font:11px var(--mono);letter-spacing:.1em;text-transform:uppercase}.sample-preview__title{display:block;font:var(--font-card);letter-spacing:var(--track-card);margin:17px 0 12px}.sample-preview__rows{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.sample-preview__rows span{padding:8px 0;border-top:1px solid #c4d0df;font:12px var(--sans)}.sample-preview__foot{display:flex;justify-content:space-between;margin-top:20px;font:600 15px var(--sans);color:var(--accent)}.sample-preview small{display:block;font:12px/1.5 var(--sans);margin-top:10px;color:var(--muted)}
@media(max-width:960px){.tabhead--project .tabhead__grid{grid-template-columns:1fr;gap:30px}.tabhead__aside{display:grid;grid-template-columns:1fr 1fr;gap:30px}.sample-preview{margin-top:0}.tabhead__aside--metrics-only{display:block}}
@media(max-width:650px){.tabhead{padding-top:36px}.tabhead__title{margin-bottom:20px}.tabhead__aside{grid-template-columns:1fr;gap:24px}.section-nav{margin-top:30px;gap:0 22px}.section-nav a{font-size:13px}.tabhead__grid{gap:24px}.sample-preview{padding:21px}}
</style>
