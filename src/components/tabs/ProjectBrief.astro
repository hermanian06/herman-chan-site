---
/**
 * One project on the Intro tab: ~30 seconds of what / why / result in bullets, a
 * three-box flow strip (in → runs → out) as the first pass at an infographic, and a
 * stat row. Every number shown is one that already lives elsewhere on the site.
 */
interface Stat {
  num: string;
  label: string;
}
interface Props {
  num: string;
  title: string;
  href: string;
  what: string[];
  why: string[];
  result: string[];
  flow: { input: string; process: string; output: string };
  stats: Stat[];
}
const { num, title, href, what, why, result, flow, stats } = Astro.props;
---

<article class="pb">
  <header class="pb__head">
    <span class="pb__num num">{num}</span>
    <h2 class="pb__title"><a href={href}>{title}</a></h2>
    <a class="pb__more" href={href}>Open the tab →</a>
  </header>

  <div class="pb__flow" aria-label={`${title}: inputs, process, outputs`}>
    <div class="pb__box"><span class="pb__boxlabel">In</span>{flow.input}</div>
    <span class="pb__arrow" aria-hidden="true">→</span>
    <div class="pb__box pb__box--core"><span class="pb__boxlabel">Runs</span>{flow.process}</div>
    <span class="pb__arrow" aria-hidden="true">→</span>
    <div class="pb__box"><span class="pb__boxlabel">Out</span>{flow.output}</div>
  </div>

  <div class="pb__cols">
    <div>
      <h3 class="pb__h3">What</h3>
      <ul>{what.map((b) => <li>{b}</li>)}</ul>
    </div>
    <div>
      <h3 class="pb__h3">Why</h3>
      <ul>{why.map((b) => <li>{b}</li>)}</ul>
    </div>
    <div>
      <h3 class="pb__h3">Result</h3>
      <ul>{result.map((b) => <li>{b}</li>)}</ul>
    </div>
  </div>

  <ul class="pb__stats" aria-label="At a glance">
    {stats.map((s) => (
      <li><b class="num">{s.num}</b><span>{s.label}</span></li>
    ))}
  </ul>
</article>

<style>
  .pb {
    border-top: 1px solid var(--rule);
    padding: var(--s-6) 0 var(--s-7);
  }
  .pb__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }
  .pb__num {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted-2);
    letter-spacing: 0.08em;
  }
  .pb__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.015em;
    margin: 0;
    flex: 1;
  }
  .pb__title a { color: var(--fg); }
  .pb__title a:hover { color: var(--accent); text-decoration: none; }
  .pb__more {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted);
    white-space: nowrap;
  }
  .pb__more:hover { color: var(--accent); text-decoration: none; }

  /* ---- flow strip (the infographic, first pass) ---- */
  .pb__flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.25fr) auto minmax(0, 1fr);
    gap: var(--s-3);
    align-items: stretch;
    margin: 0 0 var(--s-6);
  }
  .pb__box {
    border: 1px solid var(--rule);
    background: var(--bg);
    padding: var(--s-3) var(--s-4);
    font-family: var(--sans);
    font-size: var(--t-14);
    line-height: 1.45;
    color: var(--fg-soft);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pb__box--core {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--fg);
  }
  .pb__boxlabel {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-2);
  }
  .pb__box--core .pb__boxlabel { color: var(--accent); }
  .pb__arrow {
    align-self: center;
    font-family: var(--mono);
    color: var(--muted-2);
    font-size: var(--t-17);
  }

  /* ---- what / why / result ---- */
  .pb__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
  }
  .pb__h3 {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 var(--s-3);
  }
  .pb__cols ul {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: var(--s-2);
  }
  .pb__cols li {
    font-family: var(--serif);
    font-size: var(--t-15);
    line-height: 1.5;
    color: var(--fg-soft);
  }
  .pb__cols li::marker { color: var(--muted-2); }

  /* ---- stat row ---- */
  .pb__stats {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: var(--s-4) 0 0;
    border-top: 1px solid var(--rule-soft);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
  }
  .pb__stats li { display: flex; flex-direction: column; gap: 2px; }
  .pb__stats b {
    font-family: var(--mono);
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 500;
    color: var(--accent);
  }
  .pb__stats span {
    font-family: var(--sans);
    font-size: var(--t-12);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .pb__flow { grid-template-columns: minmax(0, 1fr); }
    .pb__arrow { transform: rotate(90deg); justify-self: center; }
    .pb__cols { grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
    .pb__head { flex-wrap: wrap; }
  }
</style>
