---
/**
 * One system on the Intro tab: why it was built, how it works, and what changed.
 * The Input → Process → Output flow belongs inside How; verified stats are optional.
 */
interface Stat {
  num: string;
  label: string;
}
interface Props {
  num: string;
  title: string;
  href: string;
  why: string;
  how: string;
  changed: string;
  flow: { input: string; process: string; output: string };
  stats?: Stat[];
}
const { num, title, href, why, how, changed, flow, stats = [] } = Astro.props;
---

<article class="pb">
  <header class="pb__head">
    <span class="pb__num num">{num}</span>
    <h2 class="pb__title"><a href={href}>{title}</a></h2>
  </header>

  <div class="pb__section">
    <h3 class="pb__label">Why I built it</h3>
    <p class="pb__copy">{why}</p>
  </div>

  <div class="pb__section">
    <h3 class="pb__label">How it works</h3>
    <div class="pb__flow" aria-label={`${title}: input, process, output`}>
      <div class="pb__box"><span class="pb__boxlabel">Input</span>{flow.input}</div>
      <span class="pb__arrow" aria-hidden="true">→</span>
      <div class="pb__box pb__box--core"><span class="pb__boxlabel">Process</span>{flow.process}</div>
      <span class="pb__arrow" aria-hidden="true">→</span>
      <div class="pb__box"><span class="pb__boxlabel">Output</span>{flow.output}</div>
    </div>
    <p class="pb__copy">{how}</p>
  </div>

  <div class="pb__section">
    <h3 class="pb__label">What changed</h3>
    <p class="pb__copy">{changed}</p>
  </div>

  {stats.length > 0 && (
    <ul class="pb__stats" aria-label="At a glance">
      {stats.map((s) => (
        <li><b class="num">{s.num}</b><span>{s.label}</span></li>
      ))}
    </ul>
  )}
</article>

<style>
  .pb {
    border-top: 1px solid var(--rule);
    padding: var(--s-6) 0 var(--s-7);
  }
  .pb__head {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }
  .pb__num {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted-2);
    letter-spacing: 0.08em;
  }
  .pb__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.015em;
    margin: 0;
    flex: 1;
  }
  .pb__title a { color: var(--fg); }
  .pb__title a:hover { color: var(--accent); text-decoration: none; }

  /* ---- flow strip ---- */
  .pb__flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.2fr) auto minmax(0, 1fr);
    gap: var(--s-3);
    align-items: stretch;
    margin: 0 0 var(--s-3);
  }
  .pb__box {
    border: 1px solid var(--rule);
    background: var(--bg);
    padding: var(--s-3) var(--s-4);
    font-family: var(--sans);
    font-size: var(--t-14);
    line-height: 1.45;
    color: var(--fg-soft);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pb__box--core {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--fg);
  }
  .pb__boxlabel {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-2);
  }
  .pb__box--core .pb__boxlabel { color: var(--accent); }
  .pb__arrow {
    align-self: center;
    font-family: var(--mono);
    color: var(--muted-2);
    font-size: var(--t-17);
  }

  /* ---- why, how, what changed ---- */
  .pb__section + .pb__section { margin-top: var(--s-5); }
  .pb__label {
    font-family: var(--mono);
    font-size: var(--t-12);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 var(--s-2);
  }
  .pb__copy {
    margin: 0;
    max-width: var(--measure);
    font-family: var(--serif);
    font-size: var(--t-17);
    line-height: 1.5;
    color: var(--fg-soft);
  }

  /* ---- stat row ---- */
  .pb__stats {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: var(--s-4) 0 0;
    border-top: 1px solid var(--rule-soft);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
  }
  .pb__stats li { display: flex; flex-direction: column; gap: 2px; }
  .pb__stats b {
    font-family: var(--mono);
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 500;
    color: var(--accent);
  }
  .pb__stats span {
    font-family: var(--sans);
    font-size: var(--t-12);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .pb__flow { grid-template-columns: minmax(0, 1fr); }
    .pb__arrow { transform: rotate(90deg); justify-self: center; }
    .pb__head { flex-wrap: wrap; }
  }
</style>
