---
import { projectMetrics, type Project } from '../../data/project-metrics';
interface Props { project: Project; }
const { project } = Astro.props;
const { stats, note } = projectMetrics[project];
---
<div class="project-metrics">
  <dl class="project-metrics__grid" aria-label="At a glance">
    {stats.map(({ num, label }) => <div><dt>{num}</dt><dd>{label}</dd></div>)}
  </dl>
  {note && <p class="project-metrics__note">{note}</p>}
</div>
<style>
.project-metrics__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:0;padding:24px 0;border-top:1px solid var(--rule)}
.project-metrics__grid>div{container-type:inline-size}
.project-metrics__grid dt{font-family:var(--serif);font-size:min(38px,26cqw);letter-spacing:-.045em;line-height:1.1;white-space:nowrap;color:var(--accent)}
.project-metrics__grid dd{margin:9px 0 0;font:13px/1.45 var(--sans);color:var(--fg-soft)}
.project-metrics__note{margin:0;color:var(--muted);font:13px/1.6 var(--sans);max-width:68ch}
@media(max-width:540px){.project-metrics__grid{gap:15px}.project-metrics__grid dt{font-size:min(26px,26cqw)}.project-metrics__grid dd{font-size:12px}}
</style>
