---
/**
 * A concise process for each audience, using the same ordered-step presentation
 * across all three project tabs.
 */
interface Step {
  title: string;
  body: string;
}
interface Props {
  hash?: string;
  ai: Step[];
  re: Step[];
  aiFlow?: string;
  reFlow?: string;
  aiTitle?: string;
  reTitle?: string;
}
const {
  hash = "§ 01",
  ai,
  re,
  aiFlow,
  reFlow,
  aiTitle = "For AI and data professionals",
  reTitle = "For real estate professionals",
} = Astro.props;
---

<section class="aud">
  <div class="wrap">
    <div class="section-title">
      <span class="section-title__hash">{hash}</span>
      <span class="section-title__label">How it works</span>
      <span class="section-title__hint">Two readers, one build</span>
    </div>

    <div class="aud__grid">
      <div class="aud__col">
        <h2 class="aud__h2">{aiTitle}</h2>
        {aiFlow && <p class="aud__flow"><strong>{aiFlow}</strong></p>}
        <ol class="aud__list">
          {ai.map((step) => <li><strong>{step.title}.</strong> {step.body}</li>)}
        </ol>
      </div>
      <div class="aud__col">
        <h2 class="aud__h2">{reTitle}</h2>
        {reFlow && <p class="aud__flow"><strong>{reFlow}</strong></p>}
        <ol class="aud__list">
          {re.map((step) => <li><strong>{step.title}.</strong> {step.body}</li>)}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .aud { padding: clamp(40px, 6vw, 64px) 0 0; }
  .aud__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7);
    align-items: start;
  }
  .aud__col { border-top: 1px solid var(--rule); padding-top: var(--s-4); }
  .aud__h2 {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    color: var(--accent);
    margin: 0 0 var(--s-4);
  }
  .aud__list {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: var(--s-3);
  }
  .aud__flow { margin: 0 0 var(--s-4); }
  .aud__flow,
  .aud__list li {
    font-family: var(--serif);
    font-size: var(--t-17);
    line-height: 1.5;
    color: var(--fg-soft);
  }
  .aud__list li::marker { color: var(--muted-2); }

  @media (max-width: 860px) {
    .aud__grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
  }
</style>
