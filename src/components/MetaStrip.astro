---
interface Props {
  currently?: string;
  location?: string;
  updated?: string;
}

const {
  currently = "Shipping AI into a real-estate acquisitions workflow",
  location = "San Mateo, CA",
  updated = new Date().toISOString().slice(0, 10),
} = Astro.props;
---

<div class="meta-strip">
  <div class="meta-strip__inner">
    <span class="meta-strip__pair">
      <span class="meta-strip__dot"></span><b>Currently</b>&nbsp;{currently}
    </span>
    <span class="meta-strip__pair"><b>Location</b>&nbsp;{location}</span>
    <span class="meta-strip__spacer"></span>
    <span class="meta-strip__pair">
      <b>Updated</b>&nbsp;<span class="num">{updated}</span>
    </span>
  </div>
</div>
