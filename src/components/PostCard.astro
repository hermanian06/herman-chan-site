---
interface Props {
  href: string;
  title: string;
  pubDate: Date;
  description?: string;
}

const { href, title, pubDate, description } = Astro.props;

const dateFmt = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a href={href} class="group block py-5 border-b border-rule no-underline">
  <time
    datetime={pubDate.toISOString()}
    class="text-xs uppercase tracking-wide text-ink-faint"
  >
    {dateFmt}
  </time>
  <h3 class="text-base font-medium mt-1 text-ink group-hover:underline decoration-1 underline-offset-2">
    {title}
  </h3>
  {
    description && (
      <p class="text-sm text-ink-muted mt-1">{description}</p>
    )
  }
</a>
