---
import { render, type CollectionEntry } from "astro:content";
interface Props { post: CollectionEntry<"posts">; }
const { post } = Astro.props;
const { Content } = await render(post);
---

<div class="build-story"><Content /></div>

<style>
  .build-story { min-width: 0; width: 100%; max-width: 64ch; margin: 0 auto; font-family: var(--serif); font-size: 18px; line-height: 1.65; color: var(--fg-soft); overflow-wrap: break-word; }
  .build-story :global(:where(p)) { margin: 0; text-wrap: pretty; }
  .build-story :global(> * + *) { margin-top: var(--s-5); }
  .build-story :global(strong) { color: var(--fg); font-weight: 600; }
  .build-story :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .build-story :global(code) { font-family: var(--mono); font-size: .78em; }
  .build-story :global(p code) { padding: 1px 3px; background: var(--code-bg); border: 1px solid var(--rule-soft); border-radius: 2px; overflow-wrap: anywhere; }
  .build-story :global(pre) { max-width: 100%; overflow-x: auto; padding: var(--s-4); border: 1px solid var(--rule); border-left: 2px solid var(--accent); font-family: var(--mono); font-size: 13px; line-height: 1.65; }
  .build-story :global(pre code) { font-size: inherit; }
  .build-story :global(figure) { margin-left: 0; margin-right: 0; }
  .build-story :global(figcaption) { font-family: var(--sans); font-size: var(--t-13); line-height: 1.5; color: var(--muted); margin: 0 0 var(--s-3); }
  .build-story :global(.story-flow) { margin-top: var(--s-6); margin-bottom: var(--s-6); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: var(--s-4) 0; }
  .build-story :global(.story-flow ol) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); padding: 0; margin: 0; list-style: none; counter-reset: flow; }
  .build-story :global(.story-flow li) { counter-increment: flow; font-family: var(--sans); font-size: var(--t-13); line-height: 1.45; }
  .build-story :global(.story-flow li::before) { content: counter(flow, decimal-leading-zero); display: block; margin-bottom: 5px; font-family: var(--mono); font-size: var(--t-12); color: var(--accent); }
  .build-story :global(.story-flow strong) { display: block; margin-bottom: 4px; font-weight: 600; }
  .build-story :global(.story-evidence) { padding: var(--s-4); background: var(--code-bg); border-left: 2px solid var(--accent); font-family: var(--sans); font-size: var(--t-14); line-height: 1.6; }
  .build-story :global(.story-evidence strong) { font-family: var(--mono); font-size: var(--t-12); letter-spacing: .04em; }
  .build-story :global(.story-evidence p + p) { margin-top: var(--s-3); }
  .build-story :global(table) { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: var(--t-14); line-height: 1.5; table-layout: fixed; }
  .build-story :global(th), .build-story :global(td) { text-align: left; border-bottom: 1px solid var(--rule); padding: 10px 6px; overflow-wrap: anywhere; }
  .build-story :global(th) { font-weight: 600; color: var(--fg); }
  @media (max-width: 540px) {
    .build-story { font-size: 17px; }
    .build-story :global(.story-flow ol) { grid-template-columns: 1fr; gap: var(--s-3); }
    .build-story :global(.story-flow li) { padding-left: 32px; position: relative; }
    .build-story :global(.story-flow li::before) { position: absolute; left: 0; top: 0; }
    .build-story :global(pre) { padding: var(--s-3); font-size: 12px; }
  }
</style>
