---
/**
 * Upload form for the underwriting demo.
 *
 * Speaks the demo API contract:
 *   GET  /api/meta          caps, accepted types, whether the demo is accepting runs
 *   POST /api/runs          multipart upload            -> 202 {run_id, status_url, ...}
 *   POST /api/runs/sample   no files, no checkbox       -> 202 same shape
 *   GET  /api/runs/{id}     poll until done | failed
 * Errors arrive as {error:{code,message}} and are shown as that sentence, never as JSON.
 *
 * Two things this component expects the PAGE to provide, because the results land in
 * markup the page owns:
 *   - one `[data-panel="<tab id>"]` section per tab (OutputTabs renders exactly these)
 *   - a `[data-uf-downloads]` list and a `[data-uf-expiry]` line beside it
 *
 * Progressive enhancement follows OutputTabs' reasoning: the form ships hidden and is
 * revealed only after every handler is wired, so there is never a visible control that
 * does nothing. With scripting off — or if this script throws — the "needs JavaScript"
 * line is what stays on screen.
 *
 * The style block is `is:global` on purpose: half of this UI (file rows, download rows,
 * the empty-tab line) is created at run time, and Astro's scoped attribute is only
 * stamped on markup it rendered. Every selector is namespaced under `.uf`.
 */
import {
  API_BASE_LOCAL,
  API_BASE_PRODUCTION,
  TURNSTILE_SITE_KEY,
} from "../../data/demo/config";
---

<section class="uf" data-upload-form aria-labelledby="uf-title">
  <h2 id="uf-title" class="uf__h2">Run it on a deal</h2>

  <p class="uf__nojs" data-uf-nojs>
    This demo needs JavaScript — the page sends your files to a small API and polls it
    while the pipeline runs.
  </p>

  <div class="uf__body" data-uf-body hidden>
    <div class="uf__field uf__codefield" data-uf-codefield hidden>
      <label class="uf__label" for="uf-code">Access code</label>
      <input id="uf-code" class="uf__codeinput" type="text" autocomplete="off" spellcheck="false" data-uf-code />
      <p class="uf__hint">This demo is asking for a code before it will run anything.</p>
    </div>

    <div class="uf__sample">
      <button type="button" class="uf__btn uf__btn--primary" data-uf-sample>
        Use the sample deal
      </button>
      <p class="uf__samplenote">
        No files, no checkbox. Runs the pipeline on a synthetic deal and fills every tab
        below — the fastest way to see what comes back.
      </p>
    </div>

    <p class="uf__or"><span>or run it on your own deal</span></p>

    <form class="uf__form" data-uf-form novalidate>
      <div class="uf__drop" data-uf-drop>
        <p class="uf__dropline">
          Drop files here, or
          <label class="uf__choose" for="uf-input">choose files</label>
        </p>
        <input
          id="uf-input"
          class="uf__input"
          type="file"
          multiple
          accept=".pdf,.docx,.doc,.xlsx,.xls,.csv"
          data-uf-input
          aria-describedby="uf-limits"
        />
        <p class="uf__hint" id="uf-limits" data-uf-limits></p>
      </div>

      <ul class="uf__files" data-uf-files aria-label="Chosen files" hidden></ul>

      <div class="uf__field">
        <label class="uf__label" for="uf-notes">
          Anything the pipeline should know (optional)
        </label>
        <textarea
          id="uf-notes"
          class="uf__notes"
          rows="3"
          maxlength="2000"
          data-uf-notes
          placeholder="e.g. the rent roll is as of the 1st, the T-12 runs through June."
        ></textarea>
        <p class="uf__counter" data-uf-counter></p>
      </div>

      <div class="uf__turnstile" data-uf-turnstile hidden></div>

      <label class="uf__consent">
        <input type="checkbox" required data-uf-consent />
        <span>I have the right to share these files. Files are deleted within an hour; nothing is stored or used for training.</span>
      </label>

      <button type="submit" class="uf__btn" data-uf-submit>Run the pipeline</button>
    </form>

    <p class="uf__status" data-uf-status role="status" hidden></p>
    <p class="uf__error" data-uf-error role="alert" hidden></p>
  </div>
</section>

<script
  define:vars={{ API_BASE_PRODUCTION, API_BASE_LOCAL, TURNSTILE_SITE_KEY }}
>
  (function () {
    var root = document.querySelector("[data-upload-form]");
    if (!root) return;

    var LOCAL_HOSTS = ["localhost", "127.0.0.1"];
    var BASE =
      LOCAL_HOSTS.indexOf(location.hostname) === -1
        ? API_BASE_PRODUCTION
        : API_BASE_LOCAL;

    /* The multipart field name the files are posted under. The contract writes it as
       `files[]`, which is the usual notation for "one repeated field named files". */
    var FILES_FIELD = "files";

    var POLL_MS = 2000;
    var GIVE_UP_MS = 150000;

    /* Used until GET /api/meta answers, and kept if it never does. */
    var caps = {
      max_files: 5,
      max_file_mb: 25,
      max_total_mb: 40,
      max_notes_chars: 2000,
      accepted_extensions: [".pdf", ".docx", ".doc", ".xlsx", ".xls", ".csv"],
      retention_minutes: 60,
      accepting: true,
      message: null,
    };

    var STAGE = {
      received: "Received.",
      parsing: "Reading the documents…",
      extracting: "Pulling the fields out…",
      generating: "Building the workbooks…",
      done: "Done.",
      failed: "That run failed.",
    };

    /* One sentence per status the contract can emit, used ONLY when the envelope carries
       no message of its own. The point is that no visitor ever reads
       "The demo returned an error (411)" — every code the server can answer with has prose
       waiting for it, and the generic line below is left as a backstop for a status nobody
       planned. Where the server does send a message, that message wins. */
    var STATUS_FALLBACK = {
      400: "The demo could not accept that request.",
      401: "This run needs an access code.",
      403: "That link is no longer valid.",
      404: "That run is gone — its files have already been deleted.",
      408: "That upload took too long to arrive. Try again on a steadier connection.",
      410: "That run has expired.",
      411: "That upload did not say how large it was, so the demo could not check it against the limits.",
      413: "Those files are larger than the demo accepts.",
      /* 415 has two causes: a file whose magic bytes are not an accepted type, and a POST
         whose body is not a form at all. This line has to be true of both. */
      415: "That upload was not in a format the demo accepts.",
      422: "One of those files could not be read.",
      /* Per-visitor limits run on an hourly AND a daily window, so this cannot say "today". */
      429: "You have reached the demo's per-visitor limit. Try again later.",
      503: "The demo is not accepting runs right now — try again later.",
    };

    var NETWORK_MESSAGE =
      "Could not reach the demo API. It may be offline or waking up — try again in a minute.";

    try {
      var body = root.querySelector("[data-uf-body]");
      var nojs = root.querySelector("[data-uf-nojs]");
      var form = root.querySelector("[data-uf-form]");
      var drop = root.querySelector("[data-uf-drop]");
      var input = root.querySelector("[data-uf-input]");
      var limitsEl = root.querySelector("[data-uf-limits]");
      var filesEl = root.querySelector("[data-uf-files]");
      var notesEl = root.querySelector("[data-uf-notes]");
      var counterEl = root.querySelector("[data-uf-counter]");
      var consentEl = root.querySelector("[data-uf-consent]");
      var submitEl = root.querySelector("[data-uf-submit]");
      var sampleEl = root.querySelector("[data-uf-sample]");
      var turnstileEl = root.querySelector("[data-uf-turnstile]");
      var codeEl = root.querySelector("[data-uf-code]");
      var codeFieldEl = root.querySelector("[data-uf-codefield]");
      var statusEl = root.querySelector("[data-uf-status]");
      var errorEl = root.querySelector("[data-uf-error]");

      /* The results markup (OutputTabs' panels, the downloads list, the expiry line)
         is parsed AFTER this script, which runs inline during parse. Resolve those
         nodes when a run finishes, never at init — at init they are all still null. */

      if (!body || !form || !input || !submitEl || !sampleEl) return;

      var chosen = [];
      var running = false;
      var lastRunWasSample = false;

      /* ---------- small helpers ---------- */

      function setStatus(text) {
        statusEl.textContent = text || "";
        statusEl.hidden = !text;
      }

      function setError(text) {
        errorEl.textContent = text || "";
        errorEl.hidden = !text;
      }

      function formatSize(bytes) {
        if (bytes >= 1048576) return (bytes / 1048576).toFixed(1) + " MB";
        return Math.max(1, Math.round(bytes / 1024)) + " KB";
      }

      function extensionOf(name) {
        var dot = name.lastIndexOf(".");
        return dot === -1 ? "" : name.slice(dot).toLowerCase();
      }

      function limitsText() {
        return (
          caps.accepted_extensions.join("  ") +
          " — up to " +
          caps.max_files +
          " files, " +
          caps.max_file_mb +
          " MB each, " +
          caps.max_total_mb +
          " MB total. Deleted after " +
          caps.retention_minutes +
          " minutes."
        );
      }

      function totalBytes() {
        var sum = 0;
        for (var i = 0; i < chosen.length; i++) sum += chosen[i].size;
        return sum;
      }

      function setBusy(state) {
        running = state;
        submitEl.disabled = state;
        sampleEl.disabled = state;
      }

      /* ---------- the file list ---------- */

      function renderFiles() {
        while (filesEl.firstChild) filesEl.removeChild(filesEl.firstChild);
        filesEl.hidden = chosen.length === 0;

        for (var i = 0; i < chosen.length; i++) {
          (function (file, index) {
            var li = document.createElement("li");
            li.className = "uf__file";

            var name = document.createElement("span");
            name.className = "uf__filename";
            name.textContent = file.name;

            var size = document.createElement("span");
            size.className = "uf__filesize";
            size.textContent = formatSize(file.size);

            var remove = document.createElement("button");
            remove.type = "button";
            remove.className = "uf__remove";
            remove.textContent = "Remove";
            remove.setAttribute("aria-label", "Remove " + file.name);
            remove.addEventListener("click", function () {
              chosen.splice(index, 1);
              renderFiles();
              setError("");
            });

            li.appendChild(name);
            li.appendChild(size);
            li.appendChild(remove);
            filesEl.appendChild(li);
          })(chosen[i], i);
        }
      }

      /* Client-side caps, mirrored from /api/meta. Refusals happen here, before any
         request exists — the point of the check is that nothing is sent. */
      function addFiles(list) {
        var refusals = [];
        var maxFileBytes = caps.max_file_mb * 1048576;
        var maxTotalBytes = caps.max_total_mb * 1048576;

        for (var i = 0; i < list.length; i++) {
          var file = list[i];

          if (chosen.length >= caps.max_files) {
            refusals.push(
              "This demo takes at most " +
                caps.max_files +
                " files, so " +
                file.name +
                " was not added."
            );
            continue;
          }
          if (caps.accepted_extensions.indexOf(extensionOf(file.name)) === -1) {
            refusals.push(
              file.name +
                " is not a type the demo accepts (" +
                caps.accepted_extensions.join(" ") +
                ")."
            );
            continue;
          }
          if (file.size > maxFileBytes) {
            refusals.push(
              file.name +
                " is " +
                formatSize(file.size) +
                ", over the " +
                caps.max_file_mb +
                " MB limit for one file."
            );
            continue;
          }
          if (totalBytes() + file.size > maxTotalBytes) {
            refusals.push(
              "Adding " +
                file.name +
                " would put the upload over " +
                caps.max_total_mb +
                " MB in total."
            );
            continue;
          }
          chosen.push(file);
        }

        renderFiles();
        setError(refusals.join(" "));
      }

      /* ---------- notes counter ---------- */

      function renderCounter() {
        counterEl.textContent =
          notesEl.value.length.toLocaleString() +
          " / " +
          caps.max_notes_chars.toLocaleString();
      }

      /* ---------- responses ---------- */

      function readBody(res) {
        return res.text().then(function (text) {
          if (!text) return null;
          try {
            return JSON.parse(text);
          } catch (err) {
            return null;
          }
        });
      }

      function messageFor(res, payload) {
        if (
          payload &&
          payload.error &&
          typeof payload.error.message === "string" &&
          payload.error.message
        ) {
          return payload.error.message;
        }
        return (
          STATUS_FALLBACK[res.status] ||
          "The demo returned an error (" + res.status + ")."
        );
      }

      /* The API states expiry as a Unix timestamp in SECONDS. Passing that straight to
         `new Date()` reads it as milliseconds and lands in 1970, so normalise here and
         still accept milliseconds or an ISO string if the contract ever changes. */
      function parseWhen(value) {
        var ms = null;
        if (typeof value === "number" && isFinite(value)) {
          ms = value < 1e12 ? value * 1000 : value;
        } else if (typeof value === "string" && value) {
          var n = Number(value);
          if (value.trim() !== "" && !isNaN(n)) ms = n < 1e12 ? n * 1000 : n;
          else ms = new Date(value).getTime();
        }
        if (ms === null || isNaN(ms)) return null;
        var when = new Date(ms);
        return isNaN(when.getTime()) ? null : when;
      }

      function absolute(url) {
        if (typeof url !== "string" || !url) return null;
        if (/^https?:\/\//i.test(url)) return url;
        if (url.charAt(0) === "/") return BASE + url;
        return null;
      }

      /* ---------- results ---------- */

      function fillPanels(previews) {
        var panels = document.querySelectorAll("[data-panel]");
        for (var i = 0; i < panels.length; i++) {
          var panel = panels[i];
          var id = panel.getAttribute("data-panel");
          var host = panel.firstElementChild || panel;
          var html =
            previews && typeof previews[id] === "string" ? previews[id] : null;

          if (html) {
            host.innerHTML = html;
          } else {
            while (host.firstChild) host.removeChild(host.firstChild);
            var note = document.createElement("p");
            note.className = "uf-ph";
            note.textContent = "This run did not produce that tab.";
            host.appendChild(note);
          }
        }
      }

      function fillDownloads(downloads, expiresAt) {
        var downloadsEl = document.querySelector("[data-uf-downloads]");
        var expiryEl = document.querySelector("[data-uf-expiry]");
        var noDownloadsEl = document.querySelector("[data-uf-nodownloads]");
        if (!downloadsEl) return;
        while (downloadsEl.firstChild) downloadsEl.removeChild(downloadsEl.firstChild);

        var list = downloads || [];
        var stamp = expiresAt;
        var rendered = 0;

        for (var i = 0; i < list.length; i++) {
          var item = list[i];
          var href = absolute(item && item.url);
          if (!href) continue;
          if (!stamp && item.expires_at) stamp = item.expires_at;

          var li = document.createElement("li");
          li.className = "uf-dl__item";

          var link = document.createElement("a");
          link.className = "uf-dl__link";
          link.href = href;
          link.rel = "noopener";
          link.textContent = item.label || item.name || "Download";

          li.appendChild(link);
          downloadsEl.appendChild(li);
          rendered += 1;
        }

        if (noDownloadsEl) noDownloadsEl.hidden = rendered > 0;

        if (expiryEl) {
          var when = parseWhen(stamp);
          if (when) {
            expiryEl.textContent =
              "Links expire at " +
              when.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }) +
              ".";
            expiryEl.hidden = false;
          } else {
            expiryEl.hidden = true;
          }
        }
      }

      function documentsLine(documents) {
        if (!documents || !documents.length) return "";
        var parts = [];
        for (var i = 0; i < documents.length; i++) {
          var d = documents[i];
          if (!d || !d.filename) continue;
          parts.push(d.filename + " → " + (d.role || "unclassified"));
        }
        return parts.length ? " Read as: " + parts.join(", ") + "." : "";
      }

      /* ---------- the run ---------- */

      /* The run token proves this browser started this run. It lives in this call chain
         and nowhere else — never in the URL, never in storage — so it cannot be shared by
         copying a link or survive the tab. An older server sends no token; then no header
         goes up and the poll is exactly what it was. */
      function poll(runId, statusUrl, startedAt, runToken) {
        var url = absolute(statusUrl) || BASE + "/api/runs/" + encodeURIComponent(runId);
        var headers = {};
        if (runToken) headers["X-Run-Token"] = runToken;

        fetch(url, { method: "GET", headers: headers })
          .then(function (res) {
            return readBody(res).then(function (payload) {
              /* Two answers the status route gives that are facts about the run, not
                 failures of it, so they get their own sentence rather than the generic
                 error path. */
              if (res.status === 410) {
                setBusy(false);
                setStatus("");
                setError("This run has expired — run it again.");
                return;
              }
              if (res.status === 403) {
                setBusy(false);
                setStatus("");
                setError("This run belongs to another session.");
                return;
              }
              if (!res.ok) {
                setBusy(false);
                setStatus("");
                setError(messageFor(res, payload));
                return;
              }
              if (!payload) {
                setBusy(false);
                setStatus("");
                setError("The demo returned a response this page could not read.");
                return;
              }

              var state = payload.status;

              if (state === "done") {
                setBusy(false);
                fillPanels(payload.previews);
                fillDownloads(payload.downloads, payload.expires_at);
                setStatus(
                  "Done — the tabs below are filled." +
                    (lastRunWasSample ? "" : documentsLine(payload.documents))
                );
                setError("");
                return;
              }

              if (state === "failed") {
                setBusy(false);
                setStatus("");
                setError(
                  (payload.error && payload.error.message) ||
                    "That run failed, and the demo did not say why."
                );
                return;
              }

              if (Date.now() - startedAt > GIVE_UP_MS) {
                setBusy(false);
                setStatus("");
                setError(
                  "The run is still going after two and a half minutes, which is longer than this page waits. Try again, or run the sample deal."
                );
                return;
              }

              setStatus(payload.stage_label || STAGE[state] || "Working…");
              setTimeout(function () {
                poll(runId, statusUrl, startedAt, runToken);
              }, POLL_MS);
            });
          })
          .catch(function () {
            setBusy(false);
            setStatus("");
            setError(NETWORK_MESSAGE);
          });
      }

      function startRun(path, payload, isSample) {
        lastRunWasSample = !!isSample;
        setBusy(true);
        setError("");
        setStatus("Sending…");

        fetch(BASE + path, { method: "POST", body: payload, headers: gateHeaders() })
          .then(function (res) {
            return readBody(res).then(function (data) {
              if (!res.ok || !data || !data.run_id) {
                setBusy(false);
                setStatus("");
                setError(
                  res.ok
                    ? "The demo accepted the request but did not return a run."
                    : messageFor(res, data)
                );
                return;
              }
              setStatus("Received.");
              poll(data.run_id, data.status_url, Date.now(), data.run_token);
            });
          })
          .catch(function () {
            setBusy(false);
            setStatus("");
            setError(NETWORK_MESSAGE);
          });
      }

      function turnstileToken() {
        var field = document.querySelector('[name="cf-turnstile-response"]');
        return field && field.value ? field.value : "";
      }

      function accessCode() {
        return codeEl && codeEl.value ? codeEl.value.trim() : "";
      }

      /* The bot gate and the access code now have to be readable BEFORE the multipart body
         is parsed, so they travel as headers. The same values still go up as form fields,
         which is what a server that has not moved its gate yet reads. */
      function gateHeaders() {
        var headers = { "X-Turnstile-Token": turnstileToken() };
        var code = accessCode();
        if (code) headers["X-Access-Code"] = code;
        return headers;
      }

      /* ---------- wiring ---------- */

      input.addEventListener("change", function () {
        if (input.files && input.files.length) addFiles(input.files);
        input.value = "";
      });

      ["dragenter", "dragover"].forEach(function (name) {
        drop.addEventListener(name, function (event) {
          event.preventDefault();
          drop.setAttribute("data-over", "");
        });
      });
      ["dragleave", "dragend"].forEach(function (name) {
        drop.addEventListener(name, function () {
          drop.removeAttribute("data-over");
        });
      });
      drop.addEventListener("drop", function (event) {
        event.preventDefault();
        drop.removeAttribute("data-over");
        if (event.dataTransfer && event.dataTransfer.files.length) {
          addFiles(event.dataTransfer.files);
        }
      });

      notesEl.addEventListener("input", renderCounter);

      sampleEl.addEventListener("click", function () {
        if (running) return;
        var payload = new FormData();
        payload.append("turnstile_token", turnstileToken());
        if (accessCode()) payload.append("access_code", accessCode());
        startRun("/api/runs/sample", payload, true);
      });

      /* `novalidate` is on the form so every refusal reads in the page's own voice
         rather than as a browser bubble; the checkbox keeps `required` for semantics. */
      form.addEventListener("submit", function (event) {
        event.preventDefault();
        if (running) return;

        if (!chosen.length) {
          setError("Choose at least one file, or run the sample deal.");
          return;
        }
        if (!consentEl.checked) {
          setError("Tick the box above before uploading.");
          return;
        }
        if (notesEl.value.length > caps.max_notes_chars) {
          setError("The notes box takes " + caps.max_notes_chars + " characters.");
          return;
        }

        var payload = new FormData();
        for (var i = 0; i < chosen.length; i++) {
          payload.append(FILES_FIELD, chosen[i], chosen[i].name);
        }
        payload.append("notes", notesEl.value);
        payload.append("turnstile_token", turnstileToken());
        if (accessCode()) payload.append("access_code", accessCode());
        startRun("/api/runs", payload, false);
      });

      /* Turnstile renders only when a site key exists. With none, the widget slot stays
         hidden and `turnstile_token` goes up as an empty string. */
      if (TURNSTILE_SITE_KEY) {
        var widget = document.createElement("div");
        widget.className = "cf-turnstile";
        widget.setAttribute("data-sitekey", TURNSTILE_SITE_KEY);
        turnstileEl.appendChild(widget);
        turnstileEl.hidden = false;

        var api = document.createElement("script");
        api.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
        api.async = true;
        api.defer = true;
        document.head.appendChild(api);
      }

      limitsEl.textContent = limitsText();
      renderCounter();

      /* Handlers are live, so it is now safe to show the form and retire the notice. */
      nojs.hidden = true;
      body.hidden = false;

      /* Caps come from the server when it answers; the fallback above stands if it
         does not, so a dead API costs the page nothing but its own error line. */
      fetch(BASE + "/api/meta", { method: "GET" })
        .then(function (res) {
          return res.ok ? res.json() : null;
        })
        .then(function (meta) {
          if (!meta) return;
          var keys = [
            "max_files",
            "max_file_mb",
            "max_total_mb",
            "max_notes_chars",
            "retention_minutes",
          ];
          for (var k = 0; k < keys.length; k++) {
            if (typeof meta[keys[k]] === "number") caps[keys[k]] = meta[keys[k]];
          }
          if (meta.accepted_extensions && meta.accepted_extensions.length) {
            caps.accepted_extensions = meta.accepted_extensions;
            input.setAttribute("accept", caps.accepted_extensions.join(","));
          }
          notesEl.setAttribute("maxlength", String(caps.max_notes_chars));
          limitsEl.textContent = limitsText();
          renderCounter();

          /* The field only exists when the server says a code is required; with none
             required, no X-Access-Code header and no access_code field ever go up. */
          if (meta.access_code_required === true && codeFieldEl) {
            codeFieldEl.hidden = false;
          }

          if (meta.accepting === false) {
            setBusy(true);
            setStatus(
              meta.message || "The demo is paused right now — try again later."
            );
          }
        })
        .catch(function () {
          /* Offline or not deployed yet: the hardcoded caps already stand. */
        });
    } catch (err) {
      /* Leave the "needs JavaScript" line in place: an honest notice beats a dead form. */
    }
  })();
</script>

