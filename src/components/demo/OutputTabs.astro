---
/**
 * Tab chrome for the sample-output previews.
 *
 * Vanilla JS, no framework, one inline script. Every panel ships in the HTML *and stays
 * visible* in the server-rendered markup, so with scripting off, blocked, or broken all
 * of the content is still reachable — the tab bar just does nothing. The script installs
 * the click and keyboard handlers first and collapses the panels only afterwards, during
 * parse, so there is no flash and no state in which panels are hidden with nothing able
 * to reveal them. Deep-linkable via the hash, which matters because these panels are the
 * thing a reader will want to send someone.
 */
interface Tab {
  id: string;
  label: string;
  group: string;
  html: string;
}

interface Props {
  tabs: Tab[];
}

const { tabs } = Astro.props;

const groups: { name: string; tabs: Tab[] }[] = [];
for (const tab of tabs) {
  const last = groups[groups.length - 1];
  if (last && last.name === tab.group) last.tabs.push(tab);
  else groups.push({ name: tab.group, tabs: [tab] });
}
---

<div class="ot" data-output-tabs>
  <div class="ot__bar" role="tablist" aria-label="Sample outputs">
    {groups.map((group) => (
      <div class="ot__group">
        <span class="ot__grouplabel">{group.name}</span>
        <div class="ot__groupbtns">
          {group.tabs.map((tab) => (
            <button
              type="button"
              role="tab"
              class="ot__tab"
              id={`tab-${tab.id}`}
              data-tab={tab.id}
              aria-controls={`panel-${tab.id}`}
              aria-selected="false"
            >
              {tab.label}
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>

  {tabs.map((tab) => (
    <section
      class="ot__panel"
      id={`panel-${tab.id}`}
      role="tabpanel"
      aria-labelledby={`tab-${tab.id}`}
      data-panel={tab.id}
    >
      <div set:html={tab.html} />
    </section>
  ))}
</div>

{/*
  Progressive enhancement, in one script and in one order that matters.

  Nothing is hidden in the server-rendered HTML, so with scripting off, blocked, or
  broken all eleven panels stay readable and the tab bar is simply decorative.

  Handlers are installed FIRST and the panels are collapsed only after that succeeds.
  Splitting the two — an inline initializer that hides, plus a module that wires the
  clicks — reintroduced the bug it was meant to fix: if the module failed to execute,
  ten panels were already hidden with nothing able to reveal them. A single inline
  script (no module, no bundling, no dependency on module support) cannot end up in
  that state, and the try/catch leaves everything visible if anything throws.
*/}
<script is:inline>
  (function () {
    var roots = document.querySelectorAll("[data-output-tabs]");
    for (var r = 0; r < roots.length; r++) {
      var root = roots[r];
      try {
        var buttons = root.querySelectorAll("[data-tab]");
        var panels = root.querySelectorAll("[data-panel]");
        if (!buttons.length || !panels.length) continue;

        var show = (function (buttons, panels) {
          return function (id, pushHash) {
            var known = false;
            for (var i = 0; i < buttons.length; i++) {
              if (buttons[i].getAttribute("data-tab") === id) known = true;
            }
            if (!known) return;
            for (var b = 0; b < buttons.length; b++) {
              buttons[b].setAttribute(
                "aria-selected",
                buttons[b].getAttribute("data-tab") === id ? "true" : "false"
              );
            }
            for (var p = 0; p < panels.length; p++) {
              panels[p].hidden = panels[p].getAttribute("data-panel") !== id;
            }
            if (pushHash && history.replaceState) {
              history.replaceState(null, "", "#output-" + id);
            }
          };
        })(buttons, panels);

        var ARROWS = ["ArrowRight", "ArrowLeft", "Home", "End"];
        for (var t = 0; t < buttons.length; t++) {
          (function (button, index) {
            button.addEventListener("click", function () {
              show(button.getAttribute("data-tab"), true);
            });
            button.addEventListener("keydown", function (event) {
              if (ARROWS.indexOf(event.key) === -1) return;
              event.preventDefault();
              var next;
              if (event.key === "Home") next = 0;
              else if (event.key === "End") next = buttons.length - 1;
              else if (event.key === "ArrowRight") next = (index + 1) % buttons.length;
              else next = (index - 1 + buttons.length) % buttons.length;
              buttons[next].focus();
              show(buttons[next].getAttribute("data-tab"), true);
            });
          })(buttons[t], t);
        }

        // Handlers are live from here on, so it is now safe to collapse the panels.
        var wanted = location.hash.replace(/^#output-/, "");
        var current = buttons[0].getAttribute("data-tab");
        for (var w = 0; w < buttons.length; w++) {
          if (buttons[w].getAttribute("data-tab") === wanted) current = wanted;
        }
        show(current, false);
        root.setAttribute("data-tabs-ready", "");
      } catch (err) {
        // Leave every panel visible: unstyled and untabbed beats unreachable.
        root.removeAttribute("data-tabs-ready");
      }
    }
  })();
</script>

<style>
  .ot { margin: var(--s-6) 0 0; }

  .ot__bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    padding: 0 0 var(--s-4);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--s-5);
  }
  .ot__group { display: flex; flex-direction: column; gap: 6px; }
  .ot__grouplabel {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted-2);
  }
  .ot__groupbtns { display: flex; flex-wrap: wrap; gap: 4px; }

  .ot__tab {
    font-family: var(--mono);
    font-size: var(--t-12);
    letter-spacing: 0.03em;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--rule-soft);
    border-radius: 2px;
    padding: 5px 10px;
    cursor: pointer;
    transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
  }
  .ot__tab:hover { color: var(--fg); border-color: var(--rule); }
  .ot__tab[aria-selected="true"] {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .ot__panel[hidden] { display: none; }

  @media (max-width: 640px) {
    .ot__bar { gap: var(--s-4); }
  }
</style>
