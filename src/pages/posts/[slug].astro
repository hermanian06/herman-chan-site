---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content, headings } = await render(post);

/* Determine this post's chronological number (oldest = 001). */
const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime(),
);
const postIndex = allPosts.findIndex((p) => p.id === post.id);
const numStr = String(postIndex + 1).padStart(3, "0");

const further = [...allPosts]
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3)
  .map((p) => {
    const fIdx = allPosts.findIndex((q) => q.id === p.id);
    return { post: p, num: String(fIdx + 1).padStart(3, "0") };
  });

const tocItems = headings.filter((h) => h.depth === 2);

const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
const minutes = Math.max(1, Math.round(wordCount / 230));

/* Pin to UTC — frontmatter dates are calendar dates with no zone intent. */
const dateLong = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
const dateFiled = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="post">
    <header class="post-head">
      <div class="post-head__rail">
        <span class="accent">N° {numStr}</span>
        <span class="sep">/</span>
        <span><a href="/posts/">Writing</a></span>
        {post.data.tag && (
          <>
            <span class="sep">/</span>
            <span>{post.data.tag}</span>
          </>
        )}
        <span class="sep">/</span>
        <span class="num">{dateLong}</span>
        <span class="sep">/</span>
        <span class="num">{minutes} min read</span>
      </div>
      <h1 class="post-head__title">{post.data.title}</h1>
      {post.data.description && (
        <p class="post-head__dek">{post.data.description}</p>
      )}
      <div class="post-head__byline">
        <span class="author">By Herman Chan</span>
        {post.data.tag && (
          <span>Filed under <span style="color:var(--fg-soft);">{post.data.tag}</span></span>
        )}
      </div>
    </header>

    <div class="post-grid">
      {tocItems.length > 0 ? (
        <aside class="post-toc" aria-label="In this post">
          <h4>Contents</h4>
          <ol>
            {tocItems.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </aside>
      ) : (
        <div class="post-toc-spacer" aria-hidden="true"></div>
      )}

      <div class="post-body">
        <Content />
      </div>

      <div class="marginalia-spacer" aria-hidden="true"></div>
    </div>

    <div class="post-end">
      <span>End · <span class="num">~{wordCount.toLocaleString()}</span> words</span>
      <span class="ornament">⁂</span>
      <span>Filed {dateFiled}</span>
    </div>
  </article>

  {further.length > 0 && (
    <section class="further">
      <div class="section-title">
        <span class="section-title__hash">§</span>
        <span class="section-title__label">Continue reading</span>
        <span class="section-title__hint"><a href="/posts/">All posts →</a></span>
      </div>
      <ol class="further-list">
        {further.map(({ post: p, num }) => (
          <li>
            <span class="n num">{num}</span>
            <span class="t"><a href={`/posts/${p.id}/`}>{p.data.title}</a></span>
            <span class="d">
              {p.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
                timeZone: "UTC",
              })}
              {p.data.tag && ` · ${p.data.tag}`}
            </span>
          </li>
        ))}
      </ol>
    </section>
  )}
</Layout>

<style>
  .post { padding: clamp(40px, 7vw, 80px) 0 0; }

  .post-head {
    max-width: 800px;
    margin: 0 auto var(--s-7);
    padding: 0 var(--gutter) var(--s-6);
    border-bottom: 1px solid var(--rule);
  }
  .post-head__rail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: var(--s-5);
  }
  .post-head__rail .accent { color: var(--accent); }
  .post-head__rail .sep { color: var(--rule); }
  .post-head__rail a { color: var(--muted); border-bottom: 1px solid transparent; }
  .post-head__rail a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }
  .post-head__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(36px, 5.6vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0 0 var(--s-5);
    text-wrap: balance;
  }
  .post-head__dek {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(19px, 2vw, 22px);
    line-height: 1.45;
    color: var(--muted);
    max-width: 56ch;
    margin: 0;
  }
  .post-head__byline {
    margin-top: var(--s-6);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .post-head__byline .author { color: var(--fg-soft); }

  .post-grid {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) 220px;
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }

  .post-toc {
    position: sticky;
    top: var(--s-5);
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-top: 1px solid var(--rule);
    padding-top: var(--s-4);
  }
  .post-toc h4 {
    margin: 0 0 var(--s-3);
    color: var(--muted);
    font-weight: 500;
    font-size: var(--t-12);
  }
  .post-toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc;
    display: grid;
    gap: 8px;
  }
  .post-toc li { counter-increment: toc; }
  .post-toc a {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 8px;
    color: var(--fg-soft);
    line-height: 1.4;
  }
  .post-toc a::before {
    content: counter(toc, decimal-leading-zero);
    color: var(--muted);
  }
  .post-toc a:hover { color: var(--accent); text-decoration: none; }

  .post-body {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.65;
    color: var(--fg-soft);
    max-width: 64ch;
    margin: 0 auto;
    counter-reset: postsec;
  }
  .post-body > * + * { margin-top: var(--s-5); }
  .post-body p { margin: 0; text-wrap: pretty; }
  /* First paragraph = lede with drop cap. */
  .post-body > p:first-of-type {
    font-size: 22px;
    line-height: 1.5;
    color: var(--fg);
  }
  .post-body > p:first-of-type::first-letter {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 4.2em;
    float: left;
    line-height: 0.88;
    padding: 4px 10px 0 0;
    margin-top: 4px;
    color: var(--accent);
  }
  .post-body h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--fg);
    margin-top: var(--s-7);
    counter-increment: postsec;
    scroll-margin-top: var(--s-6);
  }
  .post-body h2::before {
    content: "§ " counter(postsec, decimal-leading-zero) "  ";
    font-family: var(--mono);
    font-size: var(--t-13);
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-right: var(--s-3);
    white-space: pre;
  }
  .post-body h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 20px;
    color: var(--fg);
    margin-top: var(--s-6);
    margin-bottom: 0;
  }
  .post-body strong { color: var(--fg); font-weight: 600; }
  .post-body em { font-style: italic; }
  .post-body a {
    color: var(--accent);
    border-bottom: 1px solid var(--accent-soft);
  }
  .post-body a:hover { border-color: var(--accent); text-decoration: none; }

  .post-body ul, .post-body ol {
    padding-left: var(--s-5);
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }
  .post-body li::marker {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.85em;
  }

  .post-body blockquote {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 26px;
    line-height: 1.35;
    color: var(--fg);
    border-left: 2px solid var(--accent);
    padding: var(--s-2) 0 var(--s-2) var(--s-5);
    margin: var(--s-6) 0;
    max-width: 50ch;
  }

  .post-body pre {
    background: var(--code-bg);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    padding: var(--s-4) var(--s-5);
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg);
    margin: var(--s-6) 0;
  }
  .post-body code {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--code-bg);
    padding: 1px 6px;
    border: 1px solid var(--rule-soft);
    color: var(--fg);
    border-radius: 2px;
  }
  .post-body pre code {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: inherit;
  }

  .post-body table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--sans);
    font-size: var(--t-15);
    margin: var(--s-6) 0;
  }
  .post-body th, .post-body td {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rule-soft);
  }
  .post-body th {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    border-bottom: 1px solid var(--rule);
  }

  .post-end {
    max-width: 64ch;
    margin: var(--s-9) auto 0;
    padding: var(--s-6) 0 0;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .post-end .ornament {
    color: var(--accent);
    font-family: var(--serif);
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
    font-size: 18px;
  }

  .further {
    max-width: var(--max);
    margin: var(--s-9) auto 0;
    padding: 0 var(--gutter);
  }
  .further-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .further-list li {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--rule-soft);
    align-items: baseline;
  }
  .further-list .n {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted);
  }
  .further-list .t {
    font-family: var(--serif);
    font-size: var(--t-19);
    color: var(--fg);
    font-weight: 500;
  }
  .further-list .t a { color: inherit; }
  .further-list .t a:hover { color: var(--accent); text-decoration: none; }
  .further-list .d {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  @media (max-width: 1080px) {
    .post-grid { grid-template-columns: 1fr; }
    .post-toc {
      position: static;
      max-width: 64ch;
      margin: 0 auto var(--s-5);
    }
    .post-toc-spacer,
    .marginalia-spacer { display: none; }
  }
</style>
