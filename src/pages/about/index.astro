---
/**
 * Tab 6 — About. Herman's approved bio, September 2026.
 * Builder posture only; no career-search framing or private contact details.
 */
import Layout from "../../layouts/Layout.astro";
import TabHead from "../../components/tabs/TabHead.astro";

---

<Layout
  title="About"
  description="Herman Chan — Director of Acquisitions at Haven Realty Capital, building AI tools for rental-housing underwriting."
>
  <TabHead
    kicker="Tab 06 · About"
    title="I underwrite rental housing and build AI tools for that work."
  />

  <section class="about">
    <div class="wrap about__grid">
      <div class="about__main">
        <p>I’m Herman Chan, Director of Acquisitions at Haven Realty Capital, based in the San Francisco Bay Area. My work covers sourcing, underwriting and market research for build-to-rent, single-family rental and multifamily investments across Sunbelt markets.</p>

        <p>From 2011 to 2020, I owned and operated single-family rental homes in Houston and Phoenix, handling acquisitions, financing, renovations and property management.</p>

        <p>I started using AI in late February 2026, with no prior engineering background. I began building tools alongside my acquisitions work, starting with the tasks I kept repeating: reading deal documents, organizing financial statements, comparing rents and researching competing development.</p>

        <p>That work became the three systems on this site: an underwriting agent, a supply database and a rent database. Each grew out of a specific part of my own workflow.</p>

        <p>I use AI to write the code. My role is to define the workflow, decide how the pieces fit together and specify what a correct result should look like. I review the implementation and test the outputs against their sources. When something fails, I work through it with AI and verify the fix. I also operate the systems and review the analyses before using them in an investment decision.</p>

        <p>This site brings those projects together with sample outputs and short notes on the build process: the decisions I made, the failures I investigated and the changes that followed. It is a record of what I’m building and learning while doing the work.</p>

        <p>I hold a Master of Real Estate Development from the University of Southern California and studied management science at UC San Diego.</p>

        <p>I’m also a father, and outside work I enjoy running and training for HYROX.</p>
      </div>

      <aside class="about__aside" aria-label="At a glance">
        <dl>
          <dt>Role</dt><dd>Director of Acquisitions, Haven Realty Capital</dd>
          <dt>Domain</dt><dd>Build-to-rent · single-family rental · multifamily · Sunbelt</dd>
          <dt>Builds</dt><dd>Underwriting agent · supply database · rent database</dd>
          <dt>Stack</dt><dd>Python · Anthropic API · Model Context Protocol · Postgres · Railway</dd>
          <dt>Model</dt><dd>I define the workflow, make the system decisions and verify the results. AI writes the code.</dd>
          <dt>Connect</dt><dd><a href="https://www.linkedin.com/in/hermanchanai/">LinkedIn</a> · <a href="https://github.com/hermanian06">GitHub</a></dd>
        </dl>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .about { padding: clamp(40px, 6vw, 64px) 0 var(--s-9); }
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .about__main p {
    font: var(--font-prose);
    color: var(--fg-soft);
    margin: 0 0 var(--s-4);
  }
  .about__main p:last-child { margin-bottom: 0; }

  .about__aside {
    border-left: 1px solid var(--rule);
    padding-left: var(--s-5);
    font-family: var(--sans);
    font-size: var(--t-14);
    color: var(--fg-soft);
    position: sticky;
    top: var(--s-6);
  }
  .about__aside dl { margin: 0; display: grid; grid-template-columns: 88px 1fr; row-gap: 8px; column-gap: var(--s-3); }
  .about__aside dt {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .about__aside dd { margin: 0; }
  .about__aside dd a { color: var(--fg); border-bottom: 1px solid var(--rule); }
  .about__aside dd a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

  @media (max-width: 860px) {
    .about__grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .about__aside { border-left: 0; border-top: 1px solid var(--rule); padding: var(--s-5) 0 0; position: static; }
  }

  .about{padding-top:45px;padding-bottom:24px}.about__grid{grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:clamp(40px,7vw,100px)}.about__main{max-width:760px}.about__main p{font:var(--font-prose);margin-bottom:24px}.about__main p:nth-child(3),.about__main p:nth-child(7){padding-top:30px;margin-top:35px;border-top:1px solid var(--rule)}
  .about__aside{border:0;border-top:2px solid var(--accent);background:var(--bg-alt);padding:25px 28px;top:28px}.about__aside dl{grid-template-columns:1fr;gap:0}.about__aside dt{font:11px/1.4 var(--mono);letter-spacing:.13em;color:var(--accent-ink);padding-top:17px;border-top:1px solid #cad6e5}.about__aside dt:first-child{padding-top:0;border:0}.about__aside dd{font:15px/1.65 var(--sans);margin:6px 0 18px}.about__aside dd:last-child{margin-bottom:0}
  @media(max-width:900px){.about__grid{grid-template-columns:1fr;gap:40px}.about__main{max-width:none}.about__aside{position:static}.about__aside dl{grid-template-columns:100px minmax(0,1fr);gap:0 22px}.about__aside dd{padding:14px 0;margin:0;border-top:1px solid #cad6e5}.about__aside dt{padding:17px 0}.about__aside dt:first-child,.about__aside dd:nth-child(2){padding-top:0;border:0}.about__aside dd:last-child,.about__aside dt:nth-last-child(2){padding-bottom:0}}
  @media(max-width:540px){.about{padding-top:30px}.about__aside{padding:22px}.about__aside dl{grid-template-columns:72px minmax(0,1fr);gap:0 14px}.about__aside dd{font-size:14px}}
</style>
