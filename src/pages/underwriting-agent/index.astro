---
/**
 * Tab 2 — Underwriting Agent.
 *   §01 what / how / why, for two readers (draft bullets)
 *   §02 the sample deal, populated (the same baked previews /demo/underwriting/ renders),
 *       with the four workbooks downloadable right under the tabs
 *   §03 the upload portal (same component as /demo/underwriting/try/)
 *
 * NOTE for the Tab-2 session: Herman wants uploads with NO email step. The form shows the
 * email row only when the API's GET /api/meta says access_mode="email" — flipping that is a
 * Portfolio Demo backend change, not a change here.
 */
import Layout from "../../layouts/Layout.astro";
import TabHead from "../../components/tabs/TabHead.astro";
import TwoAudiences from "../../components/tabs/TwoAudiences.astro";
import OutputTabs from "../../components/demo/OutputTabs.astro";
import UploadForm from "../../components/demo/UploadForm.astro";
import { DEMO_TABS } from "../../data/demo/tabs";

import summaryHtml from "../../data/demo/summary.html?raw";
import compsHtml from "../../data/demo/comps.html?raw";
import propertyTaxHtml from "../../data/demo/property-tax.html?raw";
import demandHtml from "../../data/demo/demand.html?raw";
import supplyHtml from "../../data/demo/supply.html?raw";
import t12DataHtml from "../../data/demo/t12-data.html?raw";
import t12PnlHtml from "../../data/demo/t12-pnl.html?raw";
import t12ChecksHtml from "../../data/demo/t12-checks-pricing.html?raw";
import rentRollHtml from "../../data/demo/rent-roll.html?raw";
import unitMixHtml from "../../data/demo/unit-mix.html?raw";
import rentRollChecksHtml from "../../data/demo/rent-roll-checks.html?raw";
import notesHtml from "../../data/demo/notes.html?raw";
import manifestHtml from "../../data/demo/manifest.html?raw";
import auditTrailHtml from "../../data/demo/audit-trail.html?raw";

const panelHtml: Record<string, string> = {
  summary: summaryHtml,
  comps: compsHtml,
  "property-tax": propertyTaxHtml,
  demand: demandHtml,
  supply: supplyHtml,
  "t12-data": t12DataHtml,
  "t12-pnl": t12PnlHtml,
  "t12-checks": t12ChecksHtml,
  "rent-roll": rentRollHtml,
  "unit-mix": unitMixHtml,
  "rent-roll-checks": rentRollChecksHtml,
  manifest: manifestHtml,
  "audit-trail": auditTrailHtml,
  notes: notesHtml,
};
/* Herman, 2026-09-14: no Notes & disclosures tab on this page. The API still emits it. */
const PAGE_TABS = DEMO_TABS.filter((tab) => tab.id !== "notes");
const sampleTabs = PAGE_TABS.map((tab) => ({ ...tab, html: panelHtml[tab.id] }));

/* One workbook per tab group above, so what is shown is what is downloaded. */
const downloads = [
  { file: "sample-deal-summary.xlsx", name: "Deal summary", note: "Summary, rent comps, property tax, demand and supply by ring." },
  { file: "sample-t12-analysis.xlsx", name: "T-12 analysis", note: "Monthly data, P&L summary, checks and pricing." },
  { file: "sample-rent-roll-analysis.xlsx", name: "Rent roll analysis", note: "Rent roll and unit mix." },
  { file: "sample-model-ready-outputs.xlsx", name: "Model-ready outputs", note: "Field manifest, audit trail, notes and disclosures." },
];
const base = "/downloads/underwriting-demo";

const forAI = [
  "What: a headless pipeline that takes a deal's raw documents — offering memo, trailing-twelve income statement, rent roll — and produces four workbooks from one structured interchange file.",
  "How: document classification first, so file names and the exporting system do not matter; then one extraction call per document into a fixed schema; then deterministic Python for every tie-out and every workbook, with formulas left live so the arithmetic can be audited.",
  "How: each analysis is a skill — a Markdown spec plus a folder of Python tools. The model orchestrates and drafts; the code computes. Smaller models do extraction, a larger one does synthesis.",
  "Why: chained model steps compound error. The model sits at exactly the steps plain code cannot do (reading a scanned statement, judging what a document is) and nowhere else.",
  "Why: a value the pipeline cannot establish reads MISSING and carries a reason. A visible hole is cheaper than a plausible number that survives into a model.",
  "Guardrails: every bug fix is red-test-first; a reviewer model from a different vendor reads every diff cold; a field manifest maps each extracted value to the model input it fills.",
];
const forRE = [
  "Typical process: read the OM, the T-12 and the rent roll; prepare a deal summary; process and analyse the T-12 and the rent roll; build out the financial model. The underwriting agent now does all of that end to end, with a human review as the final stage.",
  "Deal summary: the basic facts of the deal — address, product type, unit count, year built, seller, broker, pricing — plus a demand-ring analysis at 1, 3, 5 and 10 miles showing household income, unemployment, population and the rest.",
  "T-12 analysis: the seller's T-12 categorised into your firm's own line items; T-12 and T-3 views; income, utility expense and utility reimbursement (RUBS) analysis.",
  "Rent roll analysis: units grouped by floor plan to find the rent for each plan; in-place rent kept apart from recently signed rent to show the trend; turnover rate and occupancy confirmed from the roll itself.",
  "Property tax: the county's billed rate looked up and applied to the purchase basis, with the source noted — so the tax line in the model is not the seller's number.",
  "Financial model: 192 fields — deal basics, T-12, rent roll, supply, demand, rent comps, property tax and more (the full list is the model-ready outputs tab) — exported in a shape that fits any company's own model.",
  "Audit trail: every published value carries a stamp — which document it came from, where in that document, whether it was read or computed, and what it was built from — so the T-12, the rent roll and the model can be cross-checked line by line.",
];
---

<Layout
  title="Underwriting agent"
  description="An agent that turns a deal's raw documents into an analysis pack: what it is, how it is built, a populated sample, one workbook to download, and an upload portal to run it on a live deal."
>
  <TabHead
    kicker="Tab 02 · Underwriting Agent"
    title="From raw documents to a finished analysis pack."
    lede="Give it the OM, the T-12 and the rent roll; it returns the deal summary, the T-12 and rent roll analyses, and every input your model needs. The sample below is exactly what comes back."
    draft
  />

  <TwoAudiences hash="§ 01" ai={forAI} re={forRE} />

  <section class="blk" id="sample">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 02</span>
        <span class="section-title__label">The sample deal</span>
        <span class="section-title__hint"><a href="#try">Try it on your own deal ↓</a></span>
      </div>
      <p class="blk__note">
        Here is the real output for a sample deal in Mesa, Arizona. All financial numbers
        are illustrative. The same output is downloadable below the tabs.
      </p>
      <OutputTabs tabs={sampleTabs} />
      <ul class="blk__fine" aria-label="What this sample is">
        <li>A real, previously marketed multifamily asset's statements, perturbed: T-12 income lines +10%, expense lines −5%, rent-roll rents +5%, lease dates one month earlier. Unit mix, vintage and size are the real ones.</li>
        <li>The address is illustrative. The demand, supply, rent-comp and property-tax tabs were pulled for that address from the same sources a live upload reads. The asset's name, seller and brokerage are withheld.</li>
        <li>Pricing is illustrative; every cap rate is computed from it. No licensed data source is used anywhere; comps come only from my own weekly rent scrape.</li>
      </ul>

      <ul class="dl" aria-label="Download the sample workbooks">
        {downloads.map((d) => (
          <li class="dl__item">
            <a class="dl__link" href={`${base}/${d.file}`} download>{d.name}</a>
            <span class="dl__note">{d.note}</span>
            <span class="dl__file">{d.file}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="blk" id="try">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 03</span>
        <span class="section-title__label">Try it on your own deal</span>
        <span class="section-title__hint">Same tabs, your files</span>
      </div>
      <p class="blk__note">
        Upload a marketing package, a trailing-twelve income statement and a rent roll, enter
        the price per unit, and the pipeline returns the same tabs for your deal. The sample
        deal runs with no files at all.
      </p>
      <UploadForm />
      <div data-uf-results>
        <OutputTabs prefix="run-" tabs={PAGE_TABS.map((t) => ({ ...t, html: '<p class="uf-ph">Run the sample deal or upload a deal to fill this tab.</p>' }))} />
      </div>
      <section class="run-dl" aria-labelledby="run-dl-title">
        <h2 id="run-dl-title" class="run-dl__h2">Workbooks from this run</h2>
        <p class="run-dl__empty" data-uf-nodownloads>Nothing yet. The workbooks appear here when a run finishes.</p>
        <ul class="uf-dl" data-uf-downloads></ul>
        <p class="run-dl__expiry" data-uf-expiry hidden></p>
      </section>
    </div>
  </section>
</Layout>

<style>
  .blk { padding: clamp(40px, 6vw, 64px) 0 0; }
  .blk:last-of-type { padding-bottom: var(--s-9); }
  .blk__note {
    font-family: var(--serif);
    font-size: var(--t-17);
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: var(--measure);
    margin: 0 0 var(--s-4);
  }
  .blk__note--small { font-size: var(--t-15); color: var(--muted); margin-top: var(--s-4); }
  .blk__fine {
    margin: var(--s-5) 0 0;
    padding-left: 1.1em;
    max-width: var(--measure);
    display: grid;
    gap: var(--s-2);
  }
  .blk__fine li { font-family: var(--serif); font-size: var(--t-14); line-height: 1.5; color: var(--muted); }
  .blk__fine li::marker { color: var(--muted-2); }

  .dl { list-style: none; margin: var(--s-6) 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .dl__item {
    display: grid;
    grid-template-columns: minmax(12rem, 20rem) 1fr auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .dl__link { font-family: var(--serif); font-size: var(--t-17); color: var(--accent); }
  .dl__note { font-family: var(--serif); font-size: var(--t-15); color: var(--muted); }
  .dl__file { font-family: var(--mono); font-size: var(--t-12); color: var(--muted-2); white-space: nowrap; }

  .run-dl { margin: var(--s-7) 0 0; }
  .run-dl__h2 {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 var(--s-4);
  }
  .run-dl__empty { font-family: var(--serif); font-size: var(--t-15); color: var(--muted); margin: 0; }
  .run-dl__expiry { font-family: var(--mono); font-size: var(--t-12); color: var(--muted-2); margin: var(--s-3) 0 0; }

  @media (max-width: 720px) {
    .dl__item { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
