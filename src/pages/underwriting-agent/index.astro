---
/**
 * Tab 2 — Underwriting Agent.
 *   §01 what / how / why, for two readers
 *   §02 the sample deal, populated (the same baked previews /demo/underwriting/ renders),
 *       with the consolidated workbook downloadable right under the tabs
 *   §03 the upload portal (same component as /demo/underwriting/try/)
 *
 * NOTE for the Tab-2 session: Herman wants uploads with NO email step. The form shows the
 * email row only when the API's GET /api/meta says access_mode="email" — flipping that is a
 * Portfolio Demo backend change, not a change here.
 */
import Layout from "../../layouts/Layout.astro";
import TabHead from "../../components/tabs/TabHead.astro";
import TwoAudiences from "../../components/tabs/TwoAudiences.astro";
import OutputTabs from "../../components/demo/OutputTabs.astro";
import UploadForm from "../../components/demo/UploadForm.astro";
import { DEMO_TABS } from "../../data/demo/tabs";

import summaryHtml from "../../data/demo/summary.html?raw";
import compsHtml from "../../data/demo/comps.html?raw";
import propertyTaxHtml from "../../data/demo/property-tax.html?raw";
import demandHtml from "../../data/demo/demand.html?raw";
import supplyHtml from "../../data/demo/supply.html?raw";
import t12DataHtml from "../../data/demo/t12-data.html?raw";
import t12PnlHtml from "../../data/demo/t12-pnl.html?raw";
import t12ChecksHtml from "../../data/demo/t12-checks-pricing.html?raw";
import rentRollHtml from "../../data/demo/rent-roll.html?raw";
import unitMixHtml from "../../data/demo/unit-mix.html?raw";
import rentRollChecksHtml from "../../data/demo/rent-roll-checks.html?raw";
import notesHtml from "../../data/demo/notes.html?raw";
import manifestHtml from "../../data/demo/manifest.html?raw";
import auditTrailHtml from "../../data/demo/audit-trail.html?raw";

const panelHtml: Record<string, string> = {
  summary: summaryHtml,
  comps: compsHtml,
  "property-tax": propertyTaxHtml,
  demand: demandHtml,
  supply: supplyHtml,
  "t12-data": t12DataHtml,
  "t12-pnl": t12PnlHtml,
  "t12-checks": t12ChecksHtml,
  "rent-roll": rentRollHtml,
  "unit-mix": unitMixHtml,
  "rent-roll-checks": rentRollChecksHtml,
  manifest: manifestHtml,
  "audit-trail": auditTrailHtml,
  notes: notesHtml,
};
/* Herman, 2026-09-14: no Notes & disclosures tab on this page. The API still emits it. */
const PAGE_TABS = DEMO_TABS.filter((tab) => tab.id !== "notes");
const sampleTabs = PAGE_TABS.map((tab) => ({ ...tab, html: panelHtml[tab.id] }));

/* One workbook, every tab in the page's order (Herman, 2026-09-14). */
const downloads = [
  { file: "sample-underwriting-pack.xlsx", name: "Underwriting pack", note: "Every tab above in one workbook, in the same order: deal summary, demand, rent comps, property tax, supply, the T-12 and rent-roll raw data / analysis / audit trail, the model-ready outputs and the audit trail." },
];
const base = "/downloads/underwriting-demo";

---

<Layout
  title="Underwriting agent"
  description="An agent that turns a deal's raw documents into an analysis pack: what it is, how it is built, a populated sample, one workbook to download, and an upload portal to run it on a live deal."
>
  <TabHead
    kicker="Tab 02 · Underwriting Agent"
    title="From raw documents to a finished analysis pack."
    lede="Give it the OM, the T-12 and the rent roll; it returns the deal summary, the T-12 and rent roll analyses, and every input your model needs. The sample below is exactly what comes back."
  />

  <TwoAudiences
    hash="§ 01"
    aiTitle="For AI and data professionals"
    reTitle="For real estate professionals"
  >
    <Fragment slot="ai">
      <p class="audience-flow"><strong>Documents → Classification → Extraction → Enrichment → Calculation → Validation → Outputs → Human review</strong></p>
      <ol class="audience-steps">
        <li><strong>Documents.</strong> The starting documents are the offering memo, income statement and rent roll.</li>
        <li><strong>Classification.</strong> The pipeline identifies each document from its contents, then routes it to the appropriate parser and extraction process.</li>
        <li><strong>Extraction.</strong> Spreadsheet parsers read rows and cells. A language model extracts property facts, maps income and expense labels into standard categories, and identifies rent-roll columns. The results follow a fixed schema—the fields and data types the pipeline expects.</li>
        <li><strong>Enrichment.</strong> The property’s location connects the deal to rent comps from my rent database, nearby development activity from my supply database, and public demographic data. Sources and coverage limitations travel with those inputs.</li>
        <li><strong>Calculation.</strong> The public demo’s Python engine applies the underwriting rules: category totals, trailing-period calculations, lease classifications, rent averages and occupancy. It computes the results without Excel installed.</li>
        <li><strong>Validation.</strong> The pipeline checks the data structure and compares calculated totals with figures printed in the source documents. Differences read <strong>REVIEW</strong>; checks without enough evidence read <strong>NOT CHECKED</strong>. Audit trails record sources and calculation inputs.</li>
        <li><strong>Outputs.</strong> One structured deal record supplies the browser previews, downloadable Excel pack and model-ready fields. The workbook contains formulas for inspection; the named fields can be mapped into an existing financial model.</li>
        <li><strong>Human review.</strong> I review the source references, flagged differences and assumptions before using the outputs in an investment decision.</li>
      </ol>
    </Fragment>
    <Fragment slot="re">
      <p class="audience-flow"><strong>Documents → Deal summary → T-12 analysis → Rent roll analysis → Property tax → Financial model → Audit trail → Human review</strong></p>
      <ol class="audience-steps">
        <li><strong>Documents.</strong> The typical process starts with the OM, the T-12 and the rent roll, then moves through the deal summary, operating analysis and financial model. The underwriting agent automates that preparation, with human review as the final stage.</li>
        <li><strong>Deal summary.</strong> The basic facts of the deal—address, product type, unit count, year built, seller, broker and pricing—plus demand analysis at 1, 3, 5 and 10 miles covering household income, unemployment, population and other local demographics.</li>
        <li><strong>T-12 analysis.</strong> The seller’s income and expenses organized into standard underwriting line items, with T-12 and T-3 views and separate analysis of other income, utility expenses and utility reimbursements (RUBS).</li>
        <li><strong>Rent roll analysis.</strong> Units grouped by floor plan, with in-place rents kept separate from recently signed rents to show the leasing trend. Occupancy and turnover are calculated from the rent roll, with the supporting dates and classifications available for review.</li>
        <li><strong>Property tax.</strong> The billed tax rate and applicable assessment basis inform the underwriting tax assumption, with sources noted and missing information flagged for follow-up.</li>
        <li><strong>Financial model.</strong> Deal basics, T-12 results, rent roll metrics, supply, demand, rent comps and property-tax assumptions become inputs to the financial model. The public demo exports these as named fields that can be mapped into a firm’s existing model; the full list appears in the model-ready outputs tab.</li>
        <li><strong>Audit trail.</strong> Source references show where figures came from, whether they were extracted or calculated, and the inputs used in the calculations, so the analyses and model inputs can be cross-checked.</li>
        <li><strong>Human review.</strong> I review the completed analyses, investigate flagged differences and confirm the assumptions before using the outputs in an investment decision.</li>
      </ol>
    </Fragment>
  </TwoAudiences>

  <section class="blk" id="sample">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 02</span>
        <span class="section-title__label">The sample deal</span>
        <span class="section-title__hint"><a href="#try">Try it on your own deal ↓</a></span>
      </div>
      <p class="blk__note">
        Here is the real output for a sample deal in Mesa, Arizona. All financial numbers
        are illustrative. The same output is downloadable below the tabs.
      </p>
      <OutputTabs tabs={sampleTabs} />

      <ul class="dl" aria-label="Download the sample workbooks">
        {downloads.map((d) => (
          <li class="dl__item">
            <a class="dl__link" href={`${base}/${d.file}`} download>{d.name}</a>
            <span class="dl__note">{d.note}</span>
            <span class="dl__file">{d.file}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="blk" id="try">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 03</span>
        <span class="section-title__label">Try it on your own deal</span>
        <span class="section-title__hint">Same tabs, your files</span>
      </div>
      <p class="blk__note">
        Upload a marketing package, a trailing-twelve income statement and a rent roll, enter
        the price per unit, and the pipeline returns the same tabs for your deal. The sample
        deal runs with no files at all.
      </p>
      <UploadForm />
      <div data-uf-results>
        <OutputTabs prefix="run-" tabs={PAGE_TABS.map((t) => ({ ...t, html: '<p class="uf-ph">Run the sample deal or upload a deal to fill this tab.</p>' }))} />
      </div>
      <section class="run-dl" aria-labelledby="run-dl-title">
        <h2 id="run-dl-title" class="run-dl__h2">Workbooks from this run</h2>
        <p class="run-dl__empty" data-uf-nodownloads>Nothing yet. The workbooks appear here when a run finishes.</p>
        <ul class="uf-dl" data-uf-downloads data-uf-only="pack"></ul>
        <p class="run-dl__expiry" data-uf-expiry hidden></p>
      </section>
    </div>
  </section>
</Layout>

<style>
  .audience-flow,
  .audience-steps li {
    font-family: var(--serif);
    font-size: var(--t-17);
    line-height: 1.5;
    color: var(--fg-soft);
  }
  .audience-flow { margin: 0 0 var(--s-4); }
  .audience-steps {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: var(--s-3);
  }
  .audience-steps li::marker { color: var(--muted-2); }

  .blk { padding: clamp(40px, 6vw, 64px) 0 0; }
  .blk:last-of-type { padding-bottom: var(--s-9); }
  .blk__note {
    font-family: var(--serif);
    font-size: var(--t-17);
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: var(--measure);
    margin: 0 0 var(--s-4);
  }
  .blk__note--small { font-size: var(--t-15); color: var(--muted); margin-top: var(--s-4); }

  .dl { list-style: none; margin: var(--s-6) 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .dl__item {
    display: grid;
    grid-template-columns: minmax(12rem, 20rem) 1fr auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .dl__link { font-family: var(--serif); font-size: var(--t-17); color: var(--accent); }
  .dl__note { font-family: var(--serif); font-size: var(--t-15); color: var(--muted); }
  .dl__file { font-family: var(--mono); font-size: var(--t-12); color: var(--muted-2); white-space: nowrap; }

  .run-dl { margin: var(--s-7) 0 0; }
  .run-dl__h2 {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 var(--s-4);
  }
  .run-dl__empty { font-family: var(--serif); font-size: var(--t-15); color: var(--muted); margin: 0; }
  .run-dl__expiry { font-family: var(--mono); font-size: var(--t-12); color: var(--muted-2); margin: var(--s-3) 0 0; }

  @media (max-width: 720px) {
    .dl__item { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
