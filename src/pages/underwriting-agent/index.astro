---
/**
 * Tab 2 — Underwriting Agent.
 *   §01 six process steps for each professional audience
 *   §02 the sample deal, populated (the same baked previews /demo/underwriting/ renders),
 *       with the consolidated workbook downloadable ABOVE the tabs (Herman, 2026-09-15)
 *   §03 the upload portal (same component as /demo/underwriting/try/)
 *
 * Uploads take NO email step and NO access code (Herman, 2026-09-15). The form's code and
 * email fields are gone, not hidden, and the service answers access_code_required:false
 * with DEMO_ACCESS_MODE=off. Both halves have to move together: a server that starts
 * demanding a code again would refuse every upload with no field to satisfy it.
 */
import Layout from "../../layouts/Layout.astro";
import TabHead from "../../components/tabs/TabHead.astro";
import TwoAudiences from "../../components/tabs/TwoAudiences.astro";
import OutputTabs from "../../components/demo/OutputTabs.astro";
import UploadForm from "../../components/demo/UploadForm.astro";
import { DEMO_TABS } from "../../data/demo/tabs";

import summaryHtml from "../../data/demo/summary.html?raw";
import compsHtml from "../../data/demo/comps.html?raw";
import propertyTaxHtml from "../../data/demo/property-tax.html?raw";
import demandHtml from "../../data/demo/demand.html?raw";
import supplyHtml from "../../data/demo/supply.html?raw";
import t12DataHtml from "../../data/demo/t12-data.html?raw";
import t12PnlHtml from "../../data/demo/t12-pnl.html?raw";
import t12ChecksHtml from "../../data/demo/t12-checks-pricing.html?raw";
import rentRollHtml from "../../data/demo/rent-roll.html?raw";
import unitMixHtml from "../../data/demo/unit-mix.html?raw";
import rentRollChecksHtml from "../../data/demo/rent-roll-checks.html?raw";
import notesHtml from "../../data/demo/notes.html?raw";
import manifestHtml from "../../data/demo/manifest.html?raw";
import auditTrailHtml from "../../data/demo/audit-trail.html?raw";

const panelHtml: Record<string, string> = {
  summary: summaryHtml,
  comps: compsHtml,
  "property-tax": propertyTaxHtml,
  demand: demandHtml,
  supply: supplyHtml,
  "t12-data": t12DataHtml,
  "t12-pnl": t12PnlHtml,
  "t12-checks": t12ChecksHtml,
  "rent-roll": rentRollHtml,
  "unit-mix": unitMixHtml,
  "rent-roll-checks": rentRollChecksHtml,
  manifest: manifestHtml,
  "audit-trail": auditTrailHtml,
  notes: notesHtml,
};
/* Herman, 2026-09-14: no Notes & disclosures tab on this page. The API still emits it. */
const PAGE_TABS = DEMO_TABS.filter((tab) => tab.id !== "notes");
const sampleTabs = PAGE_TABS.map((tab) => ({ ...tab, html: panelHtml[tab.id] }));

/* One workbook, every tab in the page's order (Herman, 2026-09-14). */
const downloads = [
  { file: "sample-underwriting-pack.xlsx", name: "Download sample Excel pack (.xlsx)", note: "Every tab below in one workbook, in the same order: deal summary, demand, rent comps, property tax, supply, the T-12 and rent-roll raw data / analysis / audit trail, the model-ready outputs and the audit trail." },
];
const base = "/downloads/underwriting-demo";

const forAI = [
  {
    "title": "Identify documents",
    "body": "The pipeline identifies the offering memo, income statement and rent roll from their contents, then routes each to the appropriate parser and extraction process."
  },
  {
    "title": "Extract data",
    "body": "Spreadsheet parsers read rows and cells. A language model extracts property facts, maps income and expense labels, and identifies rent-roll columns within a defined set of fields and data types."
  },
  {
    "title": "Add market context",
    "body": "The property’s location connects the deal to my rent and supply databases and public demographic data. Sources and coverage limitations stay with those inputs."
  },
  {
    "title": "Calculate",
    "body": "The public demo’s Python engine applies the underwriting rules: category totals, trailing-period calculations, lease classifications, rent averages and occupancy. It computes the results without Excel installed."
  },
  {
    "title": "Validate",
    "body": "Checks verify the data structure and compare calculated totals with figures printed in the source documents. Differences read REVIEW; checks without enough evidence read NOT CHECKED."
  },
  {
    "title": "Deliver for review",
    "body": "One structured deal record supplies browser previews, a downloadable Excel pack with formulas for inspection, and named model-ready fields with source references and calculation inputs. I investigate flagged differences and confirm assumptions before making an investment decision."
  }
];
const forRE = [
  {
    "title": "Deal summary",
    "body": "Starting with the offering memo, T-12 and rent roll, the agent assembles the address, product type, unit count, year built, seller, broker and pricing into a deal summary."
  },
  {
    "title": "T-12 analysis",
    "body": "Income and expenses are organized into standard underwriting line items, with trailing-twelve-month and trailing-three-month views. Other income, utility expenses and utility reimbursements (RUBS) receive separate analysis."
  },
  {
    "title": "Rent roll analysis",
    "body": "Units are grouped by floor plan, keeping in-place rents separate from recently signed rents to show the leasing trend. Occupancy and turnover come with supporting dates and classifications for review."
  },
  {
    "title": "Market and property-tax analysis",
    "body": "Rent comps, nearby supply and demographics at 1, 3, 5 and 10 miles provide market context. Billed tax rates and assessment rules inform the tax assumption, with sources noted and missing information flagged."
  },
  {
    "title": "Model inputs",
    "body": "Deal facts, operating results, rent-roll metrics and market assumptions become named fields that can be mapped into an existing financial model. The public demo’s full list appears in the model-ready outputs tab."
  },
  {
    "title": "Audit trail and review",
    "body": "Source references identify extracted figures and the inputs behind calculations. I cross-check the analyses, investigate flagged differences and confirm assumptions before using the outputs in an investment decision."
  }
];

---

<Layout
  title="Underwriting agent"
  description="An underwriting agent that prepares deal summaries, operating analyses and model-ready inputs, with source checks, a downloadable sample and human review."
>
  <TabHead
    project="underwriting"
    links={[{"href": "#how-it-works", "label": "How it works"}, {"href": "#sample", "label": "Sample deal"}, {"href": "#try", "label": "Try it on your own deal"}]}
    kicker="Tab 02 · Underwriting Agent"
    title="From deal documents to analysis ready for review."
    lede="I built an AI workflow that turns offering memoranda, financial statements and rent rolls into an Excel analysis pack. It combines document extraction, market research and calculations, with source references and flagged discrepancies for human review."
  />

  <TwoAudiences
    hash="§ 01"
    ai={forAI}
    re={forRE}
    aiFlow="Identify documents → Extract data → Add market context → Calculate → Validate → Deliver for review"
    reFlow="Deal summary → T-12 analysis → Rent roll analysis → Market and property tax → Model inputs → Audit trail and review"
  />

  <section class="blk" id="sample">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 02</span>
        <span class="section-title__label">The sample deal</span>
        <span class="section-title__hint"><a href="#try">Try it on your own deal ↓</a></span>
      </div>
      <p class="blk__note">
        Here is the real output for a sample deal in Mesa, Arizona. All financial numbers
        are illustrative. The same output is downloadable here.
      </p>

      {/* Herman, 2026-09-15: the pack download sits ABOVE the tabs — a reader who wants
          the workbook should not have to scroll past thirteen tab panels to find it. */}
      <ul class="dl dl--top" aria-label="Download the sample Excel pack">
        {downloads.map((d) => (
          <li class="dl__item">
            <a class="sample-download dl__link" href={`${base}/${d.file}`} download><span aria-hidden="true">↓</span><span>{d.name}</span></a>
            <span class="dl__note">{d.note}</span>
            <span class="dl__file">{d.file}</span>
          </li>
        ))}
      </ul>

      <OutputTabs tabs={sampleTabs} />
    </div>
  </section>

  <section class="blk" id="try">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 03</span>
        <span class="section-title__label">Try it on your own deal</span>
        <span class="section-title__hint">Same tabs, your files</span>
      </div>
      <p class="blk__note">
        Upload a marketing package, a trailing-twelve income statement and a rent roll, enter
        the price per unit, and the pipeline returns the same tabs for your deal. The sample
        deal runs with no files at all.
      </p>
      <UploadForm />
      <div data-uf-results>
        <OutputTabs prefix="run-" tabs={PAGE_TABS.map((t) => ({ ...t, html: '<p class="uf-ph">Run the sample deal or upload a deal to fill this tab.</p>' }))} />
      </div>
      <section class="run-dl" aria-labelledby="run-dl-title">
        <h2 id="run-dl-title" class="run-dl__h2">Workbooks from this run</h2>
        <p class="run-dl__empty" data-uf-nodownloads>Nothing yet. The workbooks appear here when a run finishes.</p>
        <ul class="uf-dl" data-uf-downloads data-uf-only="pack"></ul>
        <p class="run-dl__expiry" data-uf-expiry hidden></p>
      </section>
    </div>
  </section>
</Layout>

<style>
  .blk { padding: clamp(40px, 6vw, 64px) 0 0; }
  .blk:last-of-type { padding-bottom: var(--s-9); }
  .blk__note {
    font: var(--font-prose);
    color: var(--fg-soft);
    max-width: var(--measure);
    margin: 0 0 var(--s-4);
  }
  .blk__note--small { font-size: var(--t-15); color: var(--muted); margin-top: var(--s-4); }

  .sample-download { display: inline-flex; align-items: center; justify-content: center; gap: 12px; max-width: 100%; padding: 15px 20px; background: var(--accent); color: white; border: 1px solid var(--accent); font: 600 15px/1.4 var(--sans); text-align: center; }
  .sample-download:hover { background: var(--accent-ink); border-color: var(--accent-ink); color: white; text-decoration: none; }
  .dl { list-style: none; margin: var(--s-6) 0 0; padding: 0; border: 1px solid var(--rule); background: var(--bg-alt); }
  /* Above the tabs it needs a gap BELOW it as well, or the tab strip sits on its rule. */
  .dl--top { margin: var(--s-5) 0 var(--s-6); }
  .dl__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 12px 24px;
    align-items: start;
    padding: 24px;
  }
  .dl__link { grid-row: span 2; align-self: center; }
  .dl__note { font: var(--font-prose); color: var(--fg-soft); }
  .dl__file { font-family: var(--mono); font-size: var(--t-12); color: var(--muted); overflow-wrap: anywhere; }

  .run-dl { margin: var(--s-7) 0 0; }
  .run-dl__h2 {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 var(--s-4);
  }
  .run-dl__empty { font: var(--font-prose); color: var(--muted); margin: 0; }
  .run-dl__expiry { font-family: var(--mono); font-size: var(--t-12); color: var(--muted-2); margin: var(--s-3) 0 0; }

  @media (max-width: 760px) {
    .dl__item { grid-template-columns: 1fr; gap: 14px; padding: 20px; }
    .dl__link { grid-row: auto; }
  }
</style>
