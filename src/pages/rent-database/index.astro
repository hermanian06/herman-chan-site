---
/**
 * Tab 4 — Rent Database.
 *   §01 four process steps for each professional audience
 *   §02 ask the databases — the chat box over the MCP (rents + supply + demand)
 *   §03 the current rent dashboard, unchanged — RentDashboard.astro is the same body
 *   /demo/rent-database/ renders, read at build time from src/data/rents/rent-database.json.
 */
import Layout from "../../layouts/Layout.astro";
import TabHead from "../../components/tabs/TabHead.astro";
import TwoAudiences from "../../components/tabs/TwoAudiences.astro";
import RentDashboard from "../../components/rents/RentDashboard.astro";
import AskTheData from "../../components/chat/AskTheData.astro";
const forAI = [
  {
    "title": "Collect advertised prices",
    "body": "Python readers collect floor plans, rents and advertised availability from leasing websites, with a language model as fallback. Published unit prices remain distinct from ranges."
  },
  {
    "title": "Standardize rents and concessions",
    "body": "Supported free-rent offers become weeks for a standard 52-week net-effective comparison. Original offer text is retained; dollar credits are recorded separately and excluded from that calculation."
  },
  {
    "title": "Validate and track freshness",
    "body": "Checks look for missing fields, implausible rents, duplicates and stale observations against each market’s schedule. Collection dates and extraction failures remain visible for review."
  },
  {
    "title": "Supply comps and market summaries",
    "body": "Dated snapshots feed dashboards, market summaries, underwriting comps and read-only MCP tools for AI assistants. I review the pricing basis and offer terms before relying on a comp."
  }
];
const forRE = [
  {
    "title": "Find comparable communities",
    "body": "Tracked build-for-rent and apartment communities provide a starting set, compared by product, bedroom count and size. Published unit prices are distinguished from starting rents and ranges."
  },
  {
    "title": "Compare asking and net-effective rents",
    "body": "Asking rents appear alongside the effect of recorded free-rent offers, spread over a standard twelve-month comparison. Actual lease terms, eligibility, fees and dollar credits need separate review."
  },
  {
    "title": "Assess availability and market context",
    "body": "Listed units, move-in dates and market summaries put prices in context. These are advertised offers, not signed leases or a complete vacancy measure; coverage and collection dates affect the comparison."
  },
  {
    "title": "Set underwriting assumptions",
    "body": "Comps average the lowest five observed rents in a group, or all when fewer exist; range-only prices use the minimum. I confirm comparability and material offer terms before setting the rent assumption."
  }
];
---

<Layout
  title="Rent database"
  description="Advertised rents, availability and concessions from tracked rental communities, organized into asking and net-effective rent comparisons for underwriting."
>
  <TabHead
    kicker="Tab 04 · Rent Database"
    title="Advertised rents, with concessions in view."
    lede="Leasing websites provide floor plans, asking rents, availability and promotional offers for the communities I track. Collection schedules vary by market; the dashboard below summarizes recorded rents, concessions and coverage."
  />

  <TwoAudiences hash="§ 01" ai={forAI} re={forRE} />

  <section class="dash">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 02</span>
        <span class="section-title__label">Ask the databases</span>
        <span class="section-title__hint">Live · rents, supply and demand over one MCP server</span>
      </div>
      <p class="dash__note">
        Four rent methods sit on the same MCP server as the supply and demand tools —
        <code>rent_market_summary</code>, <code>rent_comps_near</code>, <code>rent_community_lookup</code>,
        <code>rent_coverage</code> — so a rent question can be chained with what is being built nearby.
        The full tool table and connect instructions are on the <a href="/supply-database/#mcp">Supply tab</a>.
      </p>
      <AskTheData page="rents" />
    </div>
  </section>

  <section class="dash">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 03</span>
        <span class="section-title__label">The dashboard</span>
        <span class="section-title__hint">Coverage · composition · concessions · the last thirty days</span>
      </div>
    </div>
  </section>
  <RentDashboard />
</Layout>

<style>
  .dash { padding: clamp(40px, 6vw, 64px) 0 0; }
  .dash__note { max-width: var(--measure, 72ch); color: var(--fg-soft); margin: 0 0 20px; }
  .dash__note code { font-family: var(--mono); font-size: 0.85em; }
</style>
