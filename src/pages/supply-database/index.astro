---
/**
 * Tab 3 — Supply Database.
 *   §01 four process steps for each professional audience
 *   §02 ask the databases — the chat box over the MCP (supply + rents + demand), the
 *       public read path the old search form was waiting for
 *   §03 how I check it — classifier evaluation, where models run + cost, one failure
 *   §04 the dashboard — SupplyDashboard.astro, read at build time from
 *       src/data/supply/supply-database.json (County Permit Pipeline's
 *       tools_local/export_public_supply_stats.py regenerates it from the live database)
 *   §05 the MCP server: endpoint, tools, how to connect
 */
import Layout from "../../layouts/Layout.astro";
import TabHead from "../../components/tabs/TabHead.astro";
import TwoAudiences from "../../components/tabs/TwoAudiences.astro";
import AskTheData from "../../components/chat/AskTheData.astro";
import SupplyDashboard from "../../components/supply/SupplyDashboard.astro";

const forAI = [
  {
    "title": "Collect public records",
    "body": "Python scrapers collect environmental filings, permits and planning cases, reusing readers where portals share software. Dates, record identifiers and source references stay with the data."
  },
  {
    "title": "Classify and connect projects",
    "body": "Rules standardize known fields; language models interpret descriptions and documents. Addresses are mapped where possible, and matching rules connect related filings in supported sources while retaining the underlying records."
  },
  {
    "title": "Check data and estimates",
    "body": "Checks flag stale data, missing locations and coverage changes; separate evaluations compare classifications with independently labelled examples. Source-reported unit counts, acreage-based estimates and assumed delivery dates are labelled separately."
  },
  {
    "title": "Deliver through dashboards and AI tools",
    "body": "Dashboards, spreadsheets, underwriting inputs and read-only MCP tools make the data searchable. I review uncertain matches and estimates; coverage varies, so no results does not establish no supply."
  }
];
const forRE = [
  {
    "title": "Find upcoming development",
    "body": "Planning cases, environmental filings and permits bring development activity into one place, helping identify potential housing supply before a community starts leasing or selling."
  },
  {
    "title": "Assess size and stage",
    "body": "Filing types and permit statuses indicate progress through proposals, approvals and construction. Published unit or lot counts are separated from acreage-based estimates; an application does not establish delivery timing."
  },
  {
    "title": "Identify competition and builders",
    "body": "Mapped projects show nearby activity and available builder, developer and applicant details. Product classifications distinguish housing types; whether homes will be rented or sold requires supporting evidence."
  },
  {
    "title": "Inform underwriting",
    "body": "Supply joins rent comps and demand data to inform leasing, concession and rent-growth assumptions, while builder activity can guide outreach. I confirm relevant projects, likely timing and coverage gaps before relying on the results."
  }
];

/* § 03 How I check it. Numbers are dated snapshots, re-measured 2026-10-02:
 *  - evals: County Permit Pipeline `python -m evals.run --surface epd_classify_dwelling`
 *    (evals.run id 15) and `--surface azdeq_classify` (id 16); goldens labelled from the
 *    filing PDF, developer site and county permits, never from model output.
 *  - Houston note: evals.tceq_houston_mf_label surface='precision' (651 filings labelled
 *    2026-06-03; production_label = the pre-fix call). 453 mf + 4 btr_sf rental, 176 sfd +
 *    5 townhome = 181 rent/sale errors. No current score is published: the June 3 rule fix
 *    was written from these goldens (a 2026-10-02 re-score of 789 = 90.6% exact is leaked).
 *  - model use: observability.llm_calls, 30 days to 2026-10-02, grouped by system_name. */
const evals = [
  { metro: "Atlanta", n: 93, exact: "82.8%", exactN: 77, bucket: "88.2%", bucketN: 82, miss: 6 },
  { metro: "Phoenix", n: 65, exact: "84.6%", exactN: 55, bucket: "86.2%", bucketN: 56, miss: 7 },
];
const modelUse = [
  { step: "Reading filing PDFs", model: "Claude Haiku 4.5", calls: "363", usd: "$3.38",
    why: "Stormwater notices and subdivision reports put the site, acreage and owner in forms and prose that rules cannot parse reliably." },
  { step: "Filling gaps in multifamily permits", model: "Haiku 4.5 + web search", calls: "198", usd: "$5.23",
    why: "Finds the developer, project name and unit count a permit leaves blank. Large backfills go through the batch API at half price." },
  { step: "Labelling product type", model: "Claude Haiku 4.5", calls: "208", usd: "$0.18",
    why: "The classifier scored above. It runs only on new filings that have no label yet." },
  { step: "The chat on this page", model: "Claude Sonnet 4.6", calls: "112", usd: "$2.50",
    why: "Chooses the tools, then writes the answer from what they return. Capped per visitor, per hour, and in dollars per day." },
];

/* The seventeen read-only tools the server exposes (all nine metros wired; rent + demand added 2026-09-15). */
const tools = [
  { name: "find_subdivisions", what: "Search the pipeline with structured filters: metro, product, stage, size, date." },
  { name: "recent_filings", what: "What was filed across the pipeline in the last N days." },
  { name: "lookup_subdivision", what: "Look up one project by name or by any of its record IDs." },
  { name: "permits_near", what: "Filings within a radius of a point in the last N days." },
  { name: "off_market_signals", what: "Projects building but not yet selling — the pre-listing pattern." },
  { name: "builder_activity", what: "One builder's activity across every source, with alias resolution." },
  { name: "canonical_project", what: "The full cross-source timeline for one project." },
  { name: "get_pdf_url", what: "A signed link to the stored source document for a filing." },
  { name: "pipeline_health", what: "Ingestion freshness per metro and per source." },
  { name: "mf_projects", what: "Late-stage multifamily and attached projects from the permit layer." },
  { name: "entitlement_leads", what: "Pre-permit leads: rezonings, PUDs, site plans, plats, district formations." },
  { name: "debt_maturities", what: "Financed multifamily with loan maturities and the permitted units within three miles. Historical: its loan data stopped updating on September 7, 2026." },
  { name: "rent_comps_near", what: "Rent database: floor-plan-level asking and net-effective rents within a radius of a point." },
  { name: "rent_market_summary", what: "Rent database: market medians, concession share and depth, availability — overall and by bed count." },
  { name: "rent_community_lookup", what: "Rent database: a community by name, with its coordinates and current floor plans." },
  { name: "rent_coverage", what: "Rent database: which markets are covered and how fresh each is." },
  { name: "demand_rings", what: "Demand: population, households, income and jobs in 1/3/5/10-mile rings around an address, from Census and LODES." },
];
---

<Layout
  title="Supply database"
  description="Housing development activity from public filings, organized by location, product type and stage to support supply research, builder outreach and underwriting."
>
  <TabHead
    project="supply"
    links={[{"href": "#how-it-works", "label": "How it works"}, {"href": "#ask", "label": "Ask the databases"}, {"href": "#checks", "label": "How I check it"}, {"href": "#dashboard", "label": "Dashboard"}, {"href": "#mcp", "label": "MCP tools"}]}
    kicker="Tab 03 · Supply Database"
    title="From scattered public filings to a clearer view of future housing supply."
    lede="I built a data pipeline that collects environmental filings, permits and planning cases from government websites and connects them into a searchable database. It helps me investigate upcoming developments, identify builders and assess future competition around a property."
  />

  <TwoAudiences hash="§ 01" ai={forAI} re={forRE} />

  <section class="blk" id="ask">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 02</span>
        <span class="section-title__label">Ask the databases</span>
        <span class="section-title__hint">Live · supply, rents and demand over one MCP server</span>
      </div>
      <p class="blk__note">
        The same server the tool table below describes, behind a chat box. Every answer shows
        which methods it called and which records it cited; a question the databases cannot
        answer says so rather than guessing.
      </p>
      <AskTheData page="supply" />
    </div>
  </section>

  <section class="blk" id="checks">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 03</span>
        <span class="section-title__label">How I check it</span>
        <span class="section-title__hint">An evaluation · where the AI runs · one failure</span>
      </div>

      <h3 class="chk__h">Does the model label filings correctly?</h3>
      <p class="blk__note">
        A language model reads each stormwater filing and says what will be built: single-family
        homes, townhomes, apartments, a mix, or unknown. I score it against filings I labelled by
        hand from the filing's PDF, the developer's website and the county's permits, never from
        the model's own answers. Re-run on October 2, 2026 with Claude Haiku 4.5; both scores
        match the June baseline.
      </p>
      <div class="tablewrap" role="region" tabindex="0" aria-label="Classifier evaluation">
        <table class="tools chk__tbl">
          <thead>
            <tr>
              <th scope="col">Metro</th>
              <th scope="col" class="num">Labelled filings</th>
              <th scope="col" class="num">Exact type</th>
              <th scope="col" class="num">Right business bucket</th>
              <th scope="col" class="num">Rent / sale errors</th>
            </tr>
          </thead>
          <tbody>
            {evals.map((e) => (
              <tr>
                <th scope="row">{e.metro}</th>
                <td class="num">{e.n}</td>
                <td class="num">{e.exact} <span class="chk__n">({e.exactN})</span></td>
                <td class="num">{e.bucket} <span class="chk__n">({e.bucketN})</span></td>
                <td class="num">{e.miss}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="blk__note blk__note--small">
        Buckets are for sale (single-family and townhome), for rent (apartments), mixed and
        unknown, plus commercial in Phoenix. A rent / sale error is the one that matters: a
        for-sale subdivision counted as rental supply distorts a rent underwrite, so any one of
        them fails the run and names the filing. In production, Atlanta adds a developer lookup
        on top of the model. I don't publish its score on these filings, because the lookup was
        built from them.
      </p>
      <p class="blk__note blk__note--small">
        Houston isn't in the table, and the reason is worth showing. Its labelling runs mostly on rules,
        with the model handling only the filings the rules can't place. On June 3, 2026 I
        hand-labelled the 651 Houston filings it had called apartments: 457 were rental housing,
        and 181 were for-sale homes or townhomes, mostly large subdivisions filed as if they
        were apartments. I rewrote the rules so other parts of a filing can overrule that.
        Re-scored today it looks far better, but I don't publish that number: the new rules were
        written from those same filings, so they would be graded on their own answer key. A
        fresh blind sample of filings the rules never saw is the next check.
      </p>

      <h3 class="chk__h">Where the AI runs, and what it costs</h3>
      <p class="blk__note">
        Every model call writes a row to a log, so this is measured, not estimated: the last 30
        days to October 2, 2026.
      </p>
      <div class="tablewrap" role="region" tabindex="0" aria-label="Model use">
        <table class="tools chk__tbl">
          <thead>
            <tr>
              <th scope="col">Step</th>
              <th scope="col">Model</th>
              <th scope="col" class="num">Calls</th>
              <th scope="col" class="num">Cost</th>
              <th scope="col">Why a model</th>
            </tr>
          </thead>
          <tbody>
            {modelUse.map((m) => (
              <tr>
                <th scope="row">{m.step}</th>
                <td>{m.model}</td>
                <td class="num">{m.calls}</td>
                <td class="num">{m.usd}</td>
                <td>{m.why}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="blk__note blk__note--small">
        The pipeline's own model calls cost about $9 a month. Everything else is ordinary code,
        on purpose: fetching, field mapping, address matching, linking filings into projects
        and the freshness checks. Those steps must give the same answer every week across
        hundreds of thousands of records, and a model would add cost and variance there without
        adding judgment.
      </p>

      <h3 class="chk__h">One failure, and the check it left behind</h3>
      <p class="blk__note">
        On June 3 a migration pointed the summary view behind the Overview and Builders pages
        at a stored copy of itself. Every refresh copied the same numbers back, so the analytics
        showed mid-May data. Nothing errored, and the project map, which reads the source tables
        directly, stayed current. It was found and fixed on
        June 5. The view was rebuilt as a live union of each metro's pipeline and checked metro
        by metro against the frozen copy before the swap.
      </p>
      <p class="blk__note">
        The lasting change is a check that compares the newest record each dashboard serves with
        the newest record ingested beneath it, so a frozen view is flagged by the daily checks
        instead of waiting for someone to notice. More failures and the tests they produced are
        in the <a href="/blog/">Chain contracts section of the Blog</a>.
      </p>
    </div>
  </section>

  <section class="blk" id="dashboard">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 04</span>
        <span class="section-title__label">The dashboard</span>
        <span class="section-title__hint">Collection methods · coverage · composition · freshness · a sample</span>
      </div>
      <p class="blk__note">
        Tracked feeds are the sources the pipeline currently collects, one public source in one
        metro; retired sources are not counted. Records are the rows those feeds hold today, not
        unique projects.
      </p>
    </div>
  </section>
  <SupplyDashboard />

  <section id="mcp" class="blk blk--last">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 05</span>
        <span class="section-title__label">The MCP server</span>
        <span class="section-title__hint">Read-only · OAuth 2.1 · all nine metros</span>
      </div>
      <p class="blk__note">
        The same database, exposed to Claude as a small set of read-only tools. I connect it
        to claude.ai once and then ask in plain English — "what has been filed near this site
        in the last ninety days", "what is this builder doing in Atlanta" — and the server runs
        the query and returns a clean answer. The chat box above uses the same tools.
      </p>

      <dl class="mcp">
        <dt>Endpoint</dt>
        <dd><code>https://permit-pipeline-mcp-production.up.railway.app/mcp</code></dd>
        <dt>Auth</dt>
        <dd>OAuth 2.1 (claude.ai custom connector) or a bearer token issued per person. Access is by invitation; the tools are read-only against the database.</dd>
        <dt>Connect</dt>
        <dd>In claude.ai: Settings → Connectors → Add custom connector → paste the endpoint → authorise. Claude Code: <code>claude mcp add --transport http supply https://permit-pipeline-mcp-production.up.railway.app/mcp</code>.</dd>
      </dl>

      <div class="tablewrap" role="region" tabindex="0" aria-label="MCP tools">
        <table class="tools">
          <thead>
            <tr><th scope="col">Tool</th><th scope="col">What it answers</th></tr>
          </thead>
          <tbody>
            {tools.map((t) => (
              <tr>
                <th scope="row"><code>{t.name}</code></th>
                <td>{t.what}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blk { padding: clamp(40px, 6vw, 64px) 0 0; }
  .blk--last { padding-bottom: var(--s-9); }
  .blk__note {
    font: var(--font-prose);
    color: var(--fg-soft);
    max-width: var(--measure);
    margin: 0 0 var(--s-5);
  }
  .blk__note--small { font-size: var(--t-15); color: var(--muted); margin: var(--s-5) 0 0; }

  /* ---- search form ---- */
  .near {
    padding: var(--s-6);
    background: var(--bg-alt);
    max-width: 72ch;
    display: grid;
    gap: var(--s-4);
  }
  .near__h2 {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    color: var(--muted);
    margin: 0;
  }
  .near__row { display: grid; gap: 6px; }
  .near__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .near__grid > div { display: grid; gap: 6px; }
  .near__label {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .near__input, .near__select {
    font-family: var(--sans);
    font-size: var(--t-14);
    padding: 8px 10px;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--rule);
    border-radius: 2px;
    width: 100%;
  }
  .near__input:disabled, .near__select:disabled { opacity: 0.6; cursor: not-allowed; }
  .near__actions { display: flex; gap: var(--s-4); align-items: center; flex-wrap: wrap; }
  .near__btn {
    font-family: var(--mono);
    font-size: var(--t-12);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 9px 16px;
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 2px;
  }
  .near__btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .near__hint { font-family: var(--serif); font-size: var(--t-14); color: var(--muted); max-width: 46ch; }

  /* ---- MCP block ---- */
  .mcp {
    margin: 0 0 var(--s-6);
    display: grid;
    grid-template-columns: 96px 1fr;
    row-gap: var(--s-3);
    column-gap: var(--s-4);
    max-width: var(--measure);
  }
  .mcp dt {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .mcp dd { margin: 0; font: var(--font-prose); color: var(--fg-soft); }
  .mcp code, .tools code {
    font-family: var(--mono);
    font-size: 0.86em;
    background: var(--code-bg);
    padding: 1px 5px;
    border-radius: 2px;
    word-break: break-all;
  }

  .tablewrap { overflow-x: auto; }
  .chk__h {
    font-family: var(--serif);
    font-size: var(--t-22);
    font-weight: 500;
    color: var(--fg);
    margin: var(--s-7, 40px) 0 var(--s-3);
  }
  .chk__h:first-of-type { margin-top: 0; }
  .chk__tbl { max-width: 100ch; margin-bottom: 0; }
  .chk__tbl .num { text-align: right; white-space: nowrap; }
  .chk__tbl tbody th { white-space: normal; }
  .chk__n { color: var(--muted); font-size: 0.9em; }
  .tools { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: var(--t-14); max-width: 80ch; }
  .tools th, .tools td { padding: 9px var(--s-3); border-bottom: 1px solid var(--rule-soft); text-align: left; vertical-align: baseline; }
  .tools thead th {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-weight: 500;
    border-bottom: 1px solid var(--rule);
  }
  .tools tbody th { font-weight: 500; white-space: nowrap; }
  .tools tbody th code { word-break: normal; }

  @media (max-width: 860px) {
    .near__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mcp { grid-template-columns: 1fr; row-gap: 4px; }
    .mcp dd { margin-bottom: var(--s-3); }
  }
</style>
