---
/**
 * Tab 5 — Blog. Posts grouped by the three systems (plus a "how I build" group), each
 * condensed to bullets from src/data/blog-outline.ts. Titles, dates and links come from
 * the post collection so they cannot drift from the post files.
 *
 * RULE carried over from the old landing page: every published post is listed here.
 * Anything not filed in the outline renders under "Unfiled" rather than disappearing.
 */
import Layout from "../../layouts/Layout.astro";
import TabHead from "../../components/tabs/TabHead.astro";
import { getCollection } from "astro:content";
import { BLOG_OUTLINE } from "../../data/blog-outline";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const bySlug = new Map(posts.map((p) => [p.id, p]));

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });

const filed = new Set<string>();
const groups = BLOG_OUTLINE.map((g) => ({
  ...g,
  posts: g.posts
    .map((op) => {
      const post = bySlug.get(op.slug);
      if (post) filed.add(op.slug);
      return post ? { ...op, post } : null;
    })
    .filter((x): x is NonNullable<typeof x> => x !== null)
    .sort((a, b) => b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime()),
}));

/* /posts/what-this-site-is/ is the site introduction; its content moved to the About tab. */
const unfiled = posts
  .filter((p) => !filed.has(p.id) && p.id !== "what-this-site-is")
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout
  title="Blog"
  description="Builder notes on the three systems, condensed: what was hard, what was thrown away, what changed."
>
  <TabHead
    kicker="Tab 05 · Blog"
    title="Builder notes, grouped by system."
    lede={`${posts.length} posts so far, each condensed to a few bullets here. Every post still opens in full.`}
    draft
  />

  <section class="blog">
    <div class="wrap">
      {groups.map((g, i) => (
        <section class="grp" id={g.key}>
          <div class="section-title">
            <span class="section-title__hash">§ 0{i + 1}</span>
            <span class="section-title__label"><a href={g.href}>{g.title}</a></span>
            <span class="section-title__hint">{g.posts.length} {g.posts.length === 1 ? "post" : "posts"}</span>
          </div>
          <p class="grp__blurb">{g.blurb}</p>

          {g.posts.length > 0 && (
            <ol class="plist">
              {g.posts.map(({ post, bullets }) => (
                <li class="pitem">
                  <div class="pitem__meta">
                    <time class="num" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                  </div>
                  <div class="pitem__body">
                    <h3 class="pitem__title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
                    <ul class="pitem__bullets">
                      {bullets.map((b) => <li>{b}</li>)}
                    </ul>
                    <a class="pitem__more" href={`/posts/${post.id}/`}>Read the post →</a>
                  </div>
                </li>
              ))}
            </ol>
          )}
        </section>
      ))}

      {unfiled.length > 0 && (
        <section class="grp" id="unfiled">
          <div class="section-title">
            <span class="section-title__hash">§ ··</span>
            <span class="section-title__label">Unfiled</span>
            <span class="section-title__hint">Published but not yet grouped above</span>
          </div>
          <ol class="plist">
            {unfiled.map((post) => (
              <li class="pitem">
                <div class="pitem__meta"><time class="num">{fmt(post.data.pubDate)}</time></div>
                <div class="pitem__body">
                  <h3 class="pitem__title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
                  {post.data.description && <p class="pitem__desc">{post.data.description}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      <div class="endplate">
        <span>{posts.length} posts</span>
        <span>Full archive at <a href="/posts/">/posts/</a></span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog { padding: clamp(40px, 6vw, 64px) 0 var(--s-9); }
  .grp + .grp { margin-top: var(--s-8); }
  .grp .section-title__label a { color: var(--fg); }
  .grp .section-title__label a:hover { color: var(--accent); text-decoration: none; }
  .grp__blurb {
    font-family: var(--serif);
    font-size: var(--t-17);
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: var(--measure);
    margin: 0 0 var(--s-5);
  }

  .plist { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .pitem {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: var(--s-5);
    padding: var(--s-5) 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .pitem__meta {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted-2);
    letter-spacing: 0.04em;
    padding-top: 6px;
  }
  .pitem__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: var(--t-22);
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-3);
  }
  .pitem__title a { color: var(--fg); }
  .pitem__title a:hover { color: var(--accent); text-decoration: none; }
  .pitem__bullets {
    margin: 0;
    padding-left: 1.1em;
    display: grid;
    gap: var(--s-2);
    max-width: var(--measure);
  }
  .pitem__bullets li {
    font-family: var(--serif);
    font-size: var(--t-15);
    line-height: 1.5;
    color: var(--fg-soft);
  }
  .pitem__bullets li::marker { color: var(--muted-2); }
  .pitem__desc {
    font-family: var(--serif);
    font-size: var(--t-15);
    color: var(--muted);
    margin: 0;
    max-width: var(--measure);
  }
  .pitem__more {
    display: inline-block;
    margin-top: var(--s-3);
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted);
  }
  .pitem__more:hover { color: var(--accent); text-decoration: none; }

  .endplate {
    margin-top: var(--s-8);
    padding: var(--s-5) 0;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .endplate a { color: var(--fg-soft); border-bottom: 1px solid var(--rule); }
  .endplate a:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }

  @media (max-width: 720px) {
    .pitem { grid-template-columns: minmax(0, 1fr); gap: var(--s-2); }
    .pitem__meta { padding-top: 0; }
    .endplate { flex-direction: column; gap: var(--s-2); }
  }
</style>
