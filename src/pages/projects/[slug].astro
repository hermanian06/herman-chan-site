---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  /* An entry carrying its own `href` lives at that URL; generating a detail page
     for it would leave an unlinked duplicate behind. */
  const projects = (await getCollection("projects")).filter((p) => !p.data.href);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

const { project } = Astro.props;
const { Content } = await render(project);

const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
/* One rule for the whole file: an entry's canonical URL is its own `href` when it
   has one, and /projects/<id>/ otherwise. Entries with an `href` get no detail
   page (see getStaticPaths above), so linking them by id would 404. */
const urlFor = (p: (typeof allProjects)[number]) => p.data.href ?? `/projects/${p.id}/`;
const idx = allProjects.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? allProjects[idx - 1] : undefined;
const next = idx < allProjects.length - 1 ? allProjects[idx + 1] : undefined;
const others = allProjects.filter((p) => p.id !== project.id);

const statusName = project.data.statusClass
  ? `pill pill--${project.data.statusClass}`
  : "pill pill--accent";

const isSeries = project.data.seriesPosts === true;
const projectPosts = (
  await getCollection("posts", ({ data }) => !data.draft)
)
  .filter((p) => p.data.project === project.id)
  .sort((a, b) =>
    isSeries
      ? a.data.pubDate.getTime() - b.data.pubDate.getTime() // reading order: oldest first
      : b.data.pubDate.getTime() - a.data.pubDate.getTime(), // newest first
  );
---

<Layout title={project.data.title} description={project.data.blurb}>
  <article>
    <!-- HEAD -->
    <section class="proj-head">
      <div class="wrap">
        <div class="proj-head__rail">
          <span><a href="/#projects">Projects</a></span>
          {project.data.category && (
            <>
              <span class="sep">/</span>
              <span>{project.data.category}</span>
            </>
          )}
        </div>

        <div class="proj-head__grid">
          <div>
            <h1 class="proj-head__title">{project.data.title}</h1>
            <p class="proj-head__dek">{project.data.blurb}</p>
          </div>

          <aside class="specs" aria-label="Project specifications">
            <div class="specs__hd">
              <span>Project sheet</span>
            </div>
            <dl>
              {project.data.role && (<><dt>Role</dt><dd>{project.data.role}</dd></>)}
              {project.data.for && (<><dt>For</dt><dd>{project.data.for}</dd></>)}
              {project.data.since && (
                <><dt>Since</dt><dd><span class="num">{project.data.since}</span></dd></>
              )}
              {project.data.status && (
                <>
                  <dt>Status</dt>
                  <dd><span class={statusName}>{project.data.status}</span></dd>
                </>
              )}
              {project.data.stack && project.data.stack.length > 0 && (
                <>
                  <dt>Stack</dt>
                  <dd>{project.data.stack.map((s) => <span class="pill">{s}</span>)}</dd>
                </>
              )}
              {project.data.sources && project.data.sources.length > 0 && (
                <>
                  <dt>Sources</dt>
                  <dd>{project.data.sources.map((s) => <span class="pill">{s}</span>)}</dd>
                </>
              )}
              {project.data.users && (
                <><dt>Users</dt><dd>{project.data.users}</dd></>
              )}
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <!-- STATS (optional) -->
    {project.data.stats && project.data.stats.length > 0 && (
      <section class="stats" aria-label="By the numbers">
        <div class="stats__inner">
          {project.data.stats.map((s) => (
            <div class="stat">
              <div class="stat__num">
                {s.num}
                {s.unit && <small>{s.unit}</small>}
              </div>
              <div class="stat__label">{s.label}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- BODY -->
    <section class="proj-body">
      <div class="prose">
        <Content />

        {project.data.timeline && project.data.timeline.length > 0 && (
          <>
            <h2><span class="h-num">§</span>Timeline</h2>
            <ol class="timeline">
              {project.data.timeline.map((t) => (
                <li>
                  <span class="when">{t.when}</span>
                  <div class="what">{t.what}</div>
                </li>
              ))}
            </ol>
          </>
        )}
      </div>

      <aside class="rail" aria-label="Project sidebar">
        {project.data.changelog && project.data.changelog.length > 0 && (
          <div class="rail-block">
            <h4>Changelog</h4>
            <ul class="changelog">
              {project.data.changelog.map((c) => (
                <li>
                  <span class="v">{c.version}<small>{c.date}</small></span>
                  <span>{c.note}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {projectPosts.length > 0 && (
          <div class="rail-block">
            <h4>{isSeries ? "Read in order" : "Related writing"}</h4>
            <ul class="related">
              {projectPosts.map((p, i) => (
                <li>
                  <a href={`/posts/${p.id}/`}>
                    <span class="n num" aria-hidden="true">{isSeries ? String(i + 1).padStart(2, "0") : "→"}</span>
                    <span>{p.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {others.length > 0 && (
          <div class="rail-block">
            <h4>Other projects</h4>
            <ul class="related">
              {others.map((p) => (
                <li>
                  <a href={urlFor(p)}>
                    <span class="n" aria-hidden="true">→</span>
                    <span>{p.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </section>

    {(prev || next) && (
      <nav class="pager" aria-label="Adjacent projects">
        {prev ? (
          <a href={urlFor(prev)}>
            <span class="pager__label">← Previous</span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a href={urlFor(next)} class="pager--right">
            <span class="pager__label">Next →</span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        ) : <span></span>}
      </nav>
    )}
  </article>
</Layout>

<style>
  .proj-head {
    border-bottom: 1px solid var(--rule);
    padding: clamp(40px, 7vw, 80px) 0 clamp(32px, 5vw, 56px);
    background: var(--bg);
  }
  .proj-head__rail {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: var(--s-5);
  }
  .proj-head__rail .accent { color: var(--accent); }
  .proj-head__rail .sep { color: var(--rule); }
  .proj-head__rail a { color: var(--muted); }
  .proj-head__rail a:hover { color: var(--accent); }

  .proj-head__grid {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .proj-head__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(40px, 6.4vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0 0 var(--s-4);
    text-wrap: balance;
  }
  .proj-head__title em {
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }
  .proj-head__dek {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(19px, 2vw, 22px);
    line-height: 1.45;
    color: var(--muted);
    max-width: 52ch;
    margin: 0;
  }

  .specs {
    border: 1px solid var(--rule);
    background: var(--bg);
  }
  .specs__hd {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--rule);
    background: var(--bg-alt);
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
  }
  .specs__hd .id { color: var(--accent); font-weight: 500; }
  .specs dl {
    margin: 0;
    padding: var(--s-4) var(--s-4) var(--s-3);
    display: grid;
    grid-template-columns: 96px 1fr;
    row-gap: 10px;
    column-gap: var(--s-4);
    font-family: var(--sans);
    font-size: var(--t-14);
  }
  .specs dt {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    align-self: center;
  }
  .specs dd { margin: 0; color: var(--fg); }
  .pill {
    display: inline-block;
    padding: 2px 8px;
    margin-right: 4px;
    margin-bottom: 4px;
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--fg-soft);
    background: var(--bg-alt);
    border: 1px solid var(--rule);
    border-radius: 2px;
  }
  .pill--accent {
    color: var(--accent);
    border-color: var(--accent-soft);
    background: var(--accent-soft);
  }
  .pill--live {
    color: #2c7a3a;
    border-color: rgba(44, 122, 58, 0.2);
    background: rgba(44, 122, 58, 0.08);
  }
  .pill--beta {
    color: var(--accent);
    border-color: var(--accent-soft);
    background: var(--accent-soft);
  }
  .pill--idle {
    color: var(--muted);
    border-color: var(--rule);
    background: var(--bg-alt);
  }

  .stats {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
  }
  .stats__inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    padding: var(--s-5) var(--s-4);
    border-right: 1px solid var(--rule-soft);
  }
  .stat:last-child { border-right: 0; }
  .stat__num {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(34px, 4vw, 44px);
    line-height: 1;
    color: var(--fg);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .stat__num small {
    font-size: 0.45em;
    color: var(--muted);
    margin-left: 4px;
    letter-spacing: 0;
  }
  .stat__label {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .proj-body {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 80px) var(--gutter) 0;
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }

  .prose {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.65;
    color: var(--fg-soft);
    max-width: 64ch;
    counter-reset: prosec;
  }
  .prose > * + * { margin-top: var(--s-5); }
  .prose p { margin: 0; text-wrap: pretty; }
  .prose h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--fg);
    margin-top: var(--s-7);
    counter-increment: prosec;
  }
  .prose h2::before {
    content: "§ " counter(prosec, decimal-leading-zero) "  ";
    font-family: var(--mono);
    font-size: var(--t-13);
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-right: var(--s-3);
    white-space: pre;
  }
  .prose h2 .h-num { display: none; }
  .prose strong { color: var(--fg); }
  .prose ul, .prose ol {
    padding-left: var(--s-5);
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }
  .prose li::marker {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.85em;
  }
  .prose a {
    color: var(--accent);
    border-bottom: 1px solid var(--accent-soft);
  }
  .prose a:hover { border-color: var(--accent); text-decoration: none; }
  .prose code {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--code-bg);
    padding: 1px 6px;
    border: 1px solid var(--rule-soft);
    color: var(--fg);
    border-radius: 2px;
  }

  .timeline {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
    border-left: 1px solid var(--rule);
    counter-reset: none;
  }
  .timeline li {
    padding: 0 0 var(--s-4) var(--s-5);
    margin-left: 4px;
    position: relative;
  }
  .timeline li::before {
    content: "";
    position: absolute;
    left: -4px; top: 8px;
    width: 7px; height: 7px;
    background: var(--accent);
    border-radius: 50%;
  }
  .timeline li::marker { content: ""; }
  .timeline .when {
    display: block;
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 2px;
  }
  .timeline .what {
    font-family: var(--serif);
    font-size: var(--t-17);
    color: var(--fg);
    line-height: 1.45;
  }

  .rail {
    position: sticky;
    top: var(--s-5);
    display: grid;
    gap: var(--s-6);
  }
  .rail-block h4 {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-weight: 500;
    margin: 0 0 var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--rule);
  }
  .changelog {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-3);
    font-family: var(--sans);
    font-size: var(--t-13);
    color: var(--fg-soft);
    line-height: 1.45;
  }
  .changelog li {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--s-3);
  }
  .changelog .v {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .changelog .v small {
    display: block;
    color: var(--muted);
  }

  .related {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-3);
  }
  .related li a {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--s-3);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--fg);
    font-family: var(--serif);
    font-size: var(--t-15);
    line-height: 1.35;
    align-items: baseline;
  }
  .related li a:hover { color: var(--accent); text-decoration: none; }
  .related li a .n {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted);
  }

  .pager {
    max-width: var(--max);
    margin: var(--s-9) auto 0;
    padding: var(--s-5) var(--gutter) 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-5);
    border-top: 1px solid var(--rule);
  }
  .pager a {
    display: grid;
    gap: 6px;
    padding: var(--s-4) 0;
    color: var(--fg);
  }
  .pager a:hover { color: var(--accent); text-decoration: none; }
  .pager--right { text-align: right; }
  .pager .pager__label {
    font-family: var(--mono);
    font-size: var(--t-12);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .pager .pager__title {
    font-family: var(--serif);
    font-size: var(--t-22);
    font-weight: 500;
    line-height: 1.2;
  }

  @media (max-width: 1000px) {
    .proj-head__grid { grid-template-columns: 1fr; }
    .stats__inner { grid-template-columns: repeat(2, 1fr); }
    .stats .stat:nth-child(2) { border-right: 0; }
    .proj-body { grid-template-columns: 1fr; }
    .rail { position: static; margin-top: var(--s-6); }
  }
  @media (max-width: 560px) {
    .stats__inner { grid-template-columns: 1fr; }
    .stat {
      border-right: 0;
      border-bottom: 1px solid var(--rule-soft);
    }
    .stat:last-child { border-bottom: 0; }
    .specs dl { grid-template-columns: 80px 1fr; }
  }
</style>
