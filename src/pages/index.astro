---
/**
 * Tab 1 — Intro. Three systems: why I built it, how it works, what changed.
 * Approved editorial structure, 2026-09-18; rent stats remain tied to the snapshot.
 * The pre-redesign landing is kept at /legacy/.
 */
import Layout from "../layouts/Layout.astro";
import ProjectBrief from "../components/tabs/ProjectBrief.astro";

---

<Layout description="Herman Chan — three systems I built to automate real estate workflows: deal analysis, housing supply research and rental pricing.">
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <span class="kicker">Intro</span>
        <h1 class="hero__title">
          Three systems I built <em>to automate my real estate workflows.</em>
        </h1>
        <p class="hero__lede">
          I work in real estate acquisitions. I built these systems to prepare deal analyses,
          research upcoming housing supply and track rental pricing. They bring the documents
          and market data I use into a repeatable underwriting process.
        </p>
      </div>

      <aside class="hero__aside" aria-label="At a glance">
        <dl>
          <dt>Role</dt><dd>Acquisitions director building AI tools for rental housing</dd>
          <dt>Focus</dt><dd>AI agents · workflow automation · evaluations · integrations</dd>
          <dt>Stack</dt><dd>Python · SQL/Postgres · LLM APIs · MCP · Railway</dd>
          <dt>Operating model</dt><dd>I define the workflows and system decisions. Claude and Codex write the code; I verify the results.</dd>
          <dt>Contact</dt><dd><a href="https://www.linkedin.com/in/hermanchanai/">LinkedIn</a> · <a href="https://github.com/hermanian06">GitHub</a></dd>
        </dl>
      </aside>
    </div>
  </section>

  <section class="briefs" id="projects">
    <div class="wrap">
      <nav class="project-index" aria-labelledby="systems-label">
        <h2 class="kicker" id="systems-label">The three systems</h2>
        <div class="project-index__links">
          <a href="#system-01"><span>01</span><strong>Underwriting agent</strong><i aria-hidden="true">→</i></a>
          <a href="#system-02"><span>02</span><strong>Supply database</strong><i aria-hidden="true">→</i></a>
          <a href="#system-03"><span>03</span><strong>Rent database</strong><i aria-hidden="true">→</i></a>
        </div>
      </nav>

      <ProjectBrief
        project="underwriting"
        num="01"
        title="Underwriting agent"
        href="/underwriting-agent/"
        why="Every deal requires similar preparation: pull property facts from the offering memo, organize the financial statements, analyze the rent roll and assemble inputs for the model."
        flow={{
          input: "Offering memo, T-12 and rent roll",
          process: "Extract, enrich, calculate and check",
          output: "Analysis pack and model inputs",
        }}
        how="The pack brings together the deal summary, operating analyses, rent comps, supply, demand and property-tax inputs, with source references and flagged differences."
        changed="Preparing a deal’s analysis used to take me about four hours. Now the agent handles the preparation, and I spend about thirty minutes reviewing the outputs, resolving discrepancies and confirming assumptions."
      />

      <ProjectBrief
        project="supply"
        num="02"
        title="Supply database"
        href="/supply-database/"
        why="Understanding future competition means piecing together development activity across separate government websites. Those filings can also identify builders and projects worth approaching before an acquisition opportunity is marketed."
        flow={{
          input: "Environmental filings, permits and planning cases",
          process: "Collect, classify and connect",
          output: "Mapped projects with development stages, unit counts and builder information",
        }}
        how="Source-reported figures and estimates are distinguished, with coverage varying by jurisdiction."
        changed="I can research development around a property and investigate builder activity from one database. The same information supports the underwriting pack’s supply analysis and questions asked through an AI assistant."
      />

      <ProjectBrief
        project="rents"
        num="03"
        title="Rent database"
        href="/rent-database/"
        why="Building a rent-comp set means visiting leasing websites, comparing floor plans and checking concessions. Prices and offers change, making that research a recurring task."
        flow={{
          input: "Community leasing websites",
          process: "Read prices, availability and concessions",
          output: "Asking and net-effective rents for underwriting comps",
        }}
        how="Code reads supported leasing platforms, with AI handling pages that need interpretation. Each observation keeps its collection date and the advertised offer for review."
        changed="The database supplies rent comps to my underwriting pack, reducing manual collection and showing concessions alongside asking rents. I can focus on whether the properties are comparable and which rent assumption the evidence supports."
      />
    </div>
  </section>
</Layout>

<style>
.hero{padding:56px 0 46px}.hero__grid{display:grid;grid-template-columns:minmax(0,1.98fr) minmax(0,1fr);gap:64px;align-items:start}
.hero__title{font:400 clamp(60px,6vw,86px)/1.065 var(--serif);letter-spacing:-.055em;margin:16px 0 26px;color:var(--fg)}.hero__title em{font-style:normal;color:var(--accent-ink)}
.hero__lede{margin:0;max-width:69ch;font:18px/1.65 var(--sans);letter-spacing:-.015em}.hero__aside dl{margin:0;display:grid;grid-template-columns:1fr}.hero__aside dt{border-top:1px solid var(--rule);padding-top:14px;font:11px/1.5 var(--mono);letter-spacing:.13em;text-transform:uppercase;color:var(--accent-ink)}.hero__aside dd{margin:6px 0 20px;font:15px/1.55 var(--sans)}
.project-index{padding-top:15px;border-top:1px solid var(--rule);margin-bottom:44px}.project-index h2{margin:0 0 14px}.project-index__links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.project-index__links a{display:flex;align-items:center;gap:21px;padding:23px;background:var(--bg-alt);min-height:108px;color:var(--accent-ink)}.project-index__links a:hover{background:#dfe8f3;text-decoration:none}.project-index__links span{font:54px/1 var(--serif);letter-spacing:-.07em;color:var(--muted-2);padding-right:20px;border-right:1px solid #cbd6e3}.project-index__links strong{font:400 23px/1.15 var(--serif);letter-spacing:-.035em;flex:1}.project-index__links i{font:24px var(--sans);color:var(--accent)}
@media(max-width:1100px){.hero__grid{gap:40px}.hero__title{font-size:68px}.project-index__links a{gap:14px;padding:20px 17px}.project-index__links span{font-size:44px;padding-right:14px}}
@media(max-width:900px){.hero__grid{grid-template-columns:1fr;gap:32px}.hero__title{max-width:850px;font-size:clamp(48px,8.8vw,72px)}.hero__aside dl{grid-template-columns:110px 1fr;gap:0 24px}.hero__aside dt,.hero__aside dd{padding:12px 0;border-top:1px solid var(--rule);margin:0}.project-index__links a{gap:10px;padding:18px 12px}.project-index__links strong{font-size:22px}.project-index__links span{font-size:35px;padding-right:10px}}
@media(max-width:540px){.hero{padding:34px 0}.hero__title{font-size:49px;letter-spacing:-.045em}.hero__lede{font-size:17px}.hero__aside dl{grid-template-columns:90px 1fr;gap:0 12px}.hero__aside dt{font-size:10px}.hero__aside dd{font-size:14px}.project-index__links{grid-template-columns:1fr;gap:8px}.project-index__links a{min-height:76px;padding:16px 19px;gap:18px}.project-index__links strong{font-size:24px}.project-index{margin-bottom:30px}}
</style>
