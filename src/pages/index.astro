---
/**
 * Tab 1 — Intro. Three systems, ~30 seconds each: what, why, result.
 * Draft bullets (2026-09-13); Herman rewrites in the Intro session.
 * The pre-redesign landing is kept at /legacy/.
 */
import Layout from "../layouts/Layout.astro";
import ProjectBrief from "../components/tabs/ProjectBrief.astro";
import db from "../data/rents/rent-database.json";

const rents = db.headline;
const k = (v: number) => (v >= 1000 ? Math.round(v / 100) / 10 + "k" : String(v));
---

<Layout description="Herman Chan — three production AI systems built for real-estate underwriting: an underwriting agent, a supply database, and a rent database.">
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <span class="kicker">Intro</span>
        <h1 class="hero__title">
          Three systems I built <em>for my own underwriting work.</em>
        </h1>
        <p class="hero__lede">
          I run acquisitions for a rental-housing investor. Over the last two years I have
          directed the build of three production systems: an agent that turns a deal's raw
          documents into an analysis pack, a database of new rental supply read from public
          filings, and a weekly census of asking rents. This is what each one is, why it
          exists, and what came out.
        </p>
        <p class="hero__draft">Draft copy — every bullet on this page gets rewritten in the Intro session.</p>
      </div>

      <aside class="hero__aside" aria-label="At a glance">
        <dl>
          <dt>Role</dt><dd>Acquisitions + AI tooling, Haven Realty Capital</dd>
          <dt>Focus</dt><dd>Rental-housing underwriting · Claude · MCP · agent workflows</dd>
          <dt>Stack</dt><dd>Python · Anthropic API · Postgres · Railway</dd>
          <dt>Operating model</dt><dd>I make the architecture calls; the models write the code</dd>
          <dt>Contact</dt><dd><a href="https://www.linkedin.com/in/hermanchanai/">LinkedIn</a> · <a href="https://github.com/hermanian06">GitHub</a></dd>
        </dl>
      </aside>
    </div>
  </section>

  <section class="briefs">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 01</span>
        <span class="section-title__label">The three systems</span>
        <span class="section-title__hint">About thirty seconds each</span>
      </div>

      <ProjectBrief
        num="01"
        title="Underwriting agent"
        href="/underwriting-agent/"
        flow={{
          input: "A deal's raw documents: the offering memo, the trailing-twelve income statement, the rent roll — in whatever shape they left the property-management system.",
          process: "Classify each document, extract its fields into one structured file, tie the numbers out, and build the workbooks with formulas left live.",
          output: "A deal summary with comps, demand and supply; a categorised T-12 with cap-rate ladders; a rent roll rolled up by floor plan; a manifest of every field and the model input it fills.",
        }}
        what={[
          "Takes a deal from raw documents to a finished analysis pack without a person in the loop.",
          "Does not replace the financial model — it fills the model's inputs and hands over a manifest of where each one goes.",
          "Comps carry asking and net-effective rent on every row; a value it cannot establish reads MISSING, never a plausible guess.",
        ]}
        why={[
          "The bottleneck was never the model. It was the two days of extraction and categorisation before the model gets touched.",
          "Definitions drifted between deals when the work was done by hand or in a chat window; two deals a month apart were not comparable.",
          "Every shop already has a model its committee trusts. Nobody wants a stranger's spreadsheet.",
        ]}
        result={[
          "The one-page deal summary went from about two hours to about fifteen minutes.",
          "The pack runs unattended on a schedule; the same definitions apply to every deal.",
          "Public sample plus an upload portal on the Underwriting Agent tab.",
        ]}
        stats={[
          { num: "2 h → 15 min", label: "one-page deal summary" },
          { num: "4", label: "workbooks per deal" },
          { num: "1", label: "structured file they are all built from" },
        ]}
      />

      <ProjectBrief
        num="02"
        title="Supply database"
        href="/supply-database/"
        flow={{
          input: "Public development filings across nine Sunbelt metros: state environmental filings, county and city permits, planning and entitlement cases.",
          process: "Scrape each portal with plain code; one language-model call per document for the fields code cannot read; classify, de-duplicate, geocode, stage.",
          output: "A map dashboard, a read-only MCP server the team queries from claude.ai in plain English, and a weekly sheet.",
        }}
        what={[
          "Watches public records in nine metros for new rental-housing supply — single-family, townhome and multifamily — from rezoning through construction.",
          "Each filing becomes one structured row: units (stated or estimated from acreage), builder, stage, location.",
          "Three signal tiers: entitlement (a year or more out), permit, construction.",
        ]}
        why={[
          "Commercial datasets see a project when it is leasing. The filings see it twelve to thirty-six months earlier — when a builder conversation is still worth having.",
          "Chained model steps compound error, so the model gets exactly one job per document and everything else stays deterministic and testable.",
          "The dashboard once served frozen numbers for two weeks with every health check green — so the checks now follow the number all the way to the screen.",
        ]}
        result={[
          "All nine metros live end-to-end on a weekly refresh since mid-2026.",
          "Ask 'what is coming within three miles of this site' and get an answer by product type and stage.",
          "An evaluation with independently labelled answers gates every prompt change.",
        ]}
        stats={[
          { num: "9", label: "metros, weekly refresh" },
          { num: "3", label: "signal tiers: entitlement · permit · construction" },
          { num: "11", label: "read-only MCP tools" },
        ]}
      />

      <ProjectBrief
        num="03"
        title="Rent database"
        href="/rent-database/"
        flow={{
          input: "The leasing page of every rental community tracked across twenty metros, read on a per-market cadence.",
          process: "Deterministic adapters for each leasing platform first; a language model only for the bespoke tail, batched overnight. Concession banners parsed into weeks.",
          output: "Asking rent and net-effective rent per floor plan, with the concession alongside — feeding the comps tab of the underwriting pack.",
        }}
        what={[
          "A weekly census of advertised rents: what every community is asking, and what it is actually giving away.",
          "Floor-plan level, with the concession stored as a number rather than a marketing line.",
          "Adapters first: a reader that fails loudly cannot hallucinate a two-bedroom.",
        ]}
        why={[
          "A comp set that ignores concessions is wrong in the direction that makes a deal look better.",
          "Listings sites publish the asking rent; none of them publish the six weeks free that turn it into an eleven-percent haircut.",
          "Paid comp services meter every pull; my own scrape does not.",
        ]}
        result={[
          `${rents.communities.toLocaleString("en-US")} communities across ${rents.markets} metros, refreshed on a rotation.`,
          "Every comp row in the underwriting pack carries asking and net-effective rent instead of one number doing both jobs.",
          "Aggregates are public on the Rent Database tab; no rent is published against a named community.",
        ]}
        stats={[
          { num: k(rents.communities), label: "communities tracked" },
          { num: String(rents.markets), label: "metros" },
          { num: rents.floor_plans.toLocaleString("en-US"), label: "live floor plans" },
        ]}
      />
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: clamp(48px, 9vw, 96px) 0 clamp(40px, 7vw, 72px);
    border-bottom: 1px solid var(--rule);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: end;
  }
  .hero__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(40px, 7.2vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.022em;
    margin: var(--s-3) 0 var(--s-5);
    text-wrap: balance;
    color: var(--fg);
  }
  .hero__title em { font-style: italic; font-weight: 400; color: var(--accent); }
  .hero__lede {
    font-family: var(--serif);
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: 52ch;
    margin: 0;
  }
  .hero__draft {
    font-family: var(--mono);
    font-size: var(--t-12);
    letter-spacing: 0.04em;
    color: var(--muted-2);
    margin: var(--s-4) 0 0;
    padding: 6px 10px;
    border: 1px dashed var(--rule);
    display: inline-block;
  }
  .hero__aside {
    border-left: 1px solid var(--rule);
    padding-left: var(--s-5);
    font-family: var(--sans);
    font-size: var(--t-14);
    color: var(--fg-soft);
    align-self: end;
  }
  .hero__aside dl {
    margin: 0;
    display: grid;
    grid-template-columns: 96px 1fr;
    row-gap: 6px;
    column-gap: var(--s-3);
  }
  .hero__aside dt {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hero__aside dd { margin: 0; }
  .hero__aside dd a { color: var(--fg); border-bottom: 1px solid var(--rule); }
  .hero__aside dd a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

  .briefs { padding: clamp(48px, 7vw, 80px) 0 var(--s-8); }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .hero__aside { border-left: 0; border-top: 1px solid var(--rule); padding: var(--s-5) 0 0; }
  }
</style>
