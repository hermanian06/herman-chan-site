---
/**
 * Tab 1 — Intro. Three systems: a flow strip, three one-line points, a stat row.
 * Draft copy (2026-09-13); Herman rewrites in the Intro session.
 * The pre-redesign landing is kept at /legacy/.
 */
import Layout from "../layouts/Layout.astro";
import ProjectBrief from "../components/tabs/ProjectBrief.astro";
import db from "../data/rents/rent-database.json";

const rents = db.headline;
/* Rounded stat labels. "~17,000" = nearest thousand; "47,000+" = floored thousand, so the
   plus sign is always true of the number the JSON actually holds. */
const approxK = (v: number) => "~" + (Math.round(v / 1000) * 1000).toLocaleString("en-US");
const floorK = (v: number) => (Math.floor(v / 1000) * 1000).toLocaleString("en-US") + "+";
---

<Layout description="Herman Chan — three production AI systems built for real-estate underwriting: an underwriting agent, a supply database, and a rent database.">
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <span class="kicker">Intro</span>
        <h1 class="hero__title">
          Three systems I built <em>to automate my real estate workflows.</em>
        </h1>
        <p class="hero__lede">
          I work on the acquisitions team at a multifamily and rental-housing company. Over
          the last six months I have directed the build of three production systems: an agent
          that turns a deal's raw documents into an analysis pack, a database of new rental
          supply read from public filings, and a database of weekly asking rents.
        </p>
      </div>

      <aside class="hero__aside" aria-label="At a glance">
        <dl>
          <dt>Role</dt><dd>Acquisitions + AI tooling, Haven Realty Capital</dd>
          <dt>Focus</dt><dd>Rental-housing underwriting · Claude · MCP · agent workflows</dd>
          <dt>Stack</dt><dd>Python · Anthropic API · Postgres · Railway</dd>
          <dt>Operating model</dt><dd>I make the architecture calls; the models write the code</dd>
          <dt>Contact</dt><dd><a href="https://www.linkedin.com/in/hermanchanai/">LinkedIn</a> · <a href="https://github.com/hermanian06">GitHub</a></dd>
        </dl>
      </aside>
    </div>
  </section>

  <section class="briefs">
    <div class="wrap">
      <div class="section-title">
        <span class="section-title__hash">§ 01</span>
        <span class="section-title__label">The three systems</span>
      </div>

      <ProjectBrief
        num="01"
        title="Underwriting agent"
        href="/underwriting-agent/"
        flow={{
          input: "The offering memo, the T-12 income and expense statement, the rent roll.",
          process: "Classify each file, extract its fields into one structured record, tie the numbers out, build the workbooks.",
          output: "Deal summary · T-12 analysis · rent roll analysis · a manifest of every model input, with supply and rent data.",
        }}
        points={[
          "What: a deal's raw documents in, a finished analysis pack out — with a person as the final quality check.",
          "Why: most of the analysis is the same workflow every time — pull the facts out of the broker's email, the marketing package, the Excel financial statements and a web search, then put them into the model.",
          "Result: one deal and its four files used to take about four human hours. Now it is about fifteen minutes of AI time and thirty minutes of human review, four to six times a week.",
        ]}
        stats={[
          { num: "4 h → 15 + 30 min", label: "per deal: AI time + human review" },
          { num: "4–6", label: "deals a week" },
          { num: "4", label: "files per deal" },
        ]}
      />

      <ProjectBrief
        num="02"
        title="Supply database"
        href="/supply-database/"
        flow={{
          input: "Public development filings across nine Sunbelt metros — environmental, permit, planning.",
          process: "Scrape each portal with plain code; a model reads the filings code can't parse and classifies the product; de-duplicate, geocode, stage.",
          output: "A supply search around any subject property address — everything in the pipeline within a 10-mile radius — on a map and through an MCP server the team asks in plain English.",
        }}
        points={[
          "What: every new rental-housing project in nine metros as one structured row — units, builder, stage, location.",
          "Why: the upcoming supply around an investment property is one of the inputs that decides the deal — and the filings show it a year or more before it starts leasing.",
          "Result: a nearby-supply check that used to require a paid data vendor now runs in-house, on demand, across nine metros.",
        ]}
        stats={[
          { num: "9", label: "metros, weekly refresh" },
          { num: "3", label: "signal tiers: entitlement · permit · construction" },
          { num: "200+", label: "public-record sources on the weekly refresh" },
        ]}
      />

      <ProjectBrief
        num="03"
        title="Rent database"
        href="/rent-database/"
        flow={{
          input: "The leasing page of every rental community tracked across twenty metros.",
          process: "A deterministic reader per leasing platform first; a model only for the bespoke tail.",
          output: "Asking rent and net-effective rent per floor plan, feeding the comps in the underwriting pack.",
        }}
        points={[
          "What: weekly tracking of every rental community's asking rent and concessions, by floor plan.",
          "Why: quickly determine the nearby market rent of an investment project to make an informed investment decision.",
          "Result: instead of going to ten different rent websites and copying rents by hand, the rent tab of the Excel model fills itself from the in-house rent database.",
        ]}
        stats={[
          { num: approxK(rents.communities), label: "communities tracked" },
          { num: String(rents.markets), label: "metros" },
          { num: floorK(rents.floor_plans), label: "live floor plans" },
        ]}
      />
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: clamp(48px, 9vw, 96px) 0 clamp(40px, 7vw, 72px);
    border-bottom: 1px solid var(--rule);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: end;
  }
  .hero__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(40px, 7.2vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.022em;
    margin: var(--s-3) 0 var(--s-5);
    text-wrap: balance;
    color: var(--fg);
  }
  .hero__title em { font-style: italic; font-weight: 400; color: var(--accent); }
  .hero__lede {
    font-family: var(--serif);
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: 52ch;
    margin: 0;
  }
  .hero__aside {
    border-left: 1px solid var(--rule);
    padding-left: var(--s-5);
    font-family: var(--sans);
    font-size: var(--t-14);
    color: var(--fg-soft);
    align-self: end;
  }
  .hero__aside dl {
    margin: 0;
    display: grid;
    grid-template-columns: 96px 1fr;
    row-gap: 6px;
    column-gap: var(--s-3);
  }
  .hero__aside dt {
    font-family: var(--mono);
    font-size: var(--t-12);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hero__aside dd { margin: 0; }
  .hero__aside dd a { color: var(--fg); border-bottom: 1px solid var(--rule); }
  .hero__aside dd a:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

  .briefs { padding: clamp(48px, 7vw, 80px) 0 var(--s-8); }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .hero__aside { border-left: 0; border-top: 1px solid var(--rule); padding: var(--s-5) 0 0; }
  }
</style>
